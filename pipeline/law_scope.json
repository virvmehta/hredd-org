{
 "mapping_version": "2026.4",
 "notes": "Phase two mapping, chapter-level. Product scope is expressed as whole HS2 chapters rather than selected HS4 lines, which is coarser but honest and over-inclusive within each chapter, the defensible choice given that enforcement follows embedded inputs across finished goods. Full CN8 enumeration is a later mapping version. Class B bands and Class C exclusions unchanged.",
 "assumptions": [
  {
   "id": "A1",
   "name": "CSDDD buyer coverage",
   "text": "The share of EU imports flowing through chains of buyers above 5,000 employees and 1.5 billion euro turnover is taken as 0.35 to 0.55, central 0.45, derived from Eurostat TEC large-enterprise import shares with a published haircut for the gap between the TEC size definition and the directive threshold."
  },
  {
   "id": "A2",
   "name": "CSRD reporter coverage",
   "text": "The share of EU imports entering chains of CSRD-reporting companies is taken as 0.50 to 0.70, central 0.60, on the same TEC basis with a smaller haircut for the lower threshold."
  },
  {
   "id": "A3",
   "name": "National diligence buyer coverage",
   "text": "For member-state regimes with employee thresholds near 1,000, the covered share of that market's imports is taken as 0.50 to 0.70, central 0.60. For thresholds near 5,000, the band is 0.30 to 0.50, central 0.40."
  },
  {
   "id": "A4",
   "name": "Disclosure regime buyer coverage",
   "text": "For disclosure regimes with revenue thresholds, covered import shares scale with threshold height: United Kingdom central 0.75, Canada central 0.70, Australia central 0.60, Norway central 0.55, each with a band of plus or minus 0.10."
  },
  {
   "id": "A5",
   "name": "UFLPA enforcement weighting",
   "text": "The legal ceiling is all United States imports under the rebuttable presumption. The central estimate counts CBP priority sectors only, namely cotton-adjacent apparel and textiles, solar and polysilicon headings, and tomatoes. The published band runs from the priority-sector figure to the legal ceiling."
  },
  {
   "id": "A6",
   "name": "Netherlands child labour scope",
   "text": "The NL CLDD covers companies delivering to Dutch end users regardless of size, so the covered share of Dutch imports is taken as 0.75 to 0.90, central 0.85."
  }
 ],
