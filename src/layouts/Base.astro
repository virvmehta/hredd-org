---
import '../styles/global.css';
import { getAllArticles, getSiteSettings } from '../lib/sanity.js';
import { computeVolIssue } from '../lib/volIssue.js';
import { t, localeOf, pathInLocale, LOCALES, LOCALE_LABEL, LOCALE_DRAFT } from '../lib/i18n.js';

const {
  title = 'hredd.org | Human rights and environmental due diligence, tracked from the Global South',
  description = 'Tracking global HREDD legislation and its implications for those most affected and least consulted.',
  active = '',
  // SEO / social props, all optional so existing pages keep working unchanged:
  ogType = 'website',        // set to 'article' on article pages
  ogImage = 'https://hredd.org/og-default.png',
  publishedTime = null,      // ISO date, articles only
  modifiedTime = null,       // ISO date, articles/laws when known
  noindex = false
} = Astro.props;

const articles = await getAllArticles();
const settings = await getSiteSettings();
const volIssue = computeVolIssue(articles);
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).toString();
const tagline = settings?.tagline || 'Tracking global HREDD legislation and its implications for those most affected and least consulted. Established 2026.';

// Locale is derived from the URL (/bn/... is Bangla, everything else English).
const locale = localeOf(Astro.url.pathname);
const htmlLang = locale === 'bn' ? 'bn' : 'en-GB';
// Where the current page lives in each locale, for the switcher and hreflang.
// Only pages that actually exist in Bangla should offer the switch; a `pages`
// prop can constrain this later. For the pilot, the switcher is shown on pages
// that pass `localized` (currently the homepage).
const { localized = false } = Astro.props;
const altHref = (loc) => new URL(pathInLocale(Astro.url.pathname, loc), Astro.site).toString();
const homeHref = locale === 'bn' ? '/bn/' : '/';
// Nav labels are translated; the destinations stay on the canonical (English)
// pages, since only the homepage is localised in this pilot. The wordmark and
// switcher are the only links that change target by locale.
const nav = [
  { key: 'nav.tracker', href: '/tracker/', active: 'tracker' },
  { key: 'nav.timeline', href: '/timeline/', active: 'timeline' },
  { key: 'nav.trade', href: '/trade/', active: 'trade' },
  { key: 'nav.buyers', href: '/buyer-mapping/', active: 'buyer-mapping' },
  { key: 'nav.report', href: '/report/', active: 'report' },
  { key: 'nav.articles', href: '/articles/', active: 'articles' },
  { key: 'nav.about', href: '/about/', active: 'about' },
  { key: 'nav.subscribe', href: '/subscribe/', active: 'subscribe' },
];
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<link rel="canonical" href={canonicalURL} />
{localized && <link rel="alternate" hreflang="en" href={altHref('en')} />}
{localized && <link rel="alternate" hreflang="bn" href={altHref('bn')} />}
{localized && <link rel="alternate" hreflang="x-default" href={altHref('en')} />}
<meta property="og:site_name" content="hredd.org" />
<meta property="og:locale" content={locale === 'bn' ? 'bn_BD' : 'en_GB'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content={title} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "hredd.org",
  "url": "https://hredd.org",
  "description": "Tracking global HREDD legislation and its implications for those most affected and least consulted.",
  "publisher": { "@type": "Organization", "name": "hredd.org", "url": "https://hredd.org" }
})} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" sizes="480x480" />
<link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/favicon.png" />
<script is:inline>document.documentElement.classList.add('js');</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
{locale === 'bn' && <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Bengali:wght@400;500&family=Noto+Sans+Bengali:wght@400;500&display=swap" rel="stylesheet" />}
<script async src="https://www.googletagmanager.com/gtag/js?id=G-12M8LFB8G1"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-12M8LFB8G1');
</script>
</head>
<body>

<header class="masthead">
  <div class="mast-main">
    <div class="wrap">
      <nav class="mast-nav left">
        {nav.slice(0, 4).map((n) => (
          <a href={n.href} aria-current={active === n.active ? 'page' : undefined}>{t(locale, n.key)}</a>
        ))}
      </nav>
      <a class="wordmark" href={homeHref}><b>hredd</b><i>.org</i></a>
      <nav class="mast-nav right">
        {nav.slice(4).map((n) => (
          <a href={n.href} aria-current={active === n.active ? 'page' : undefined}>{t(locale, n.key)}</a>
        ))}
        {localized && <a class="lang-switch" href={altHref(locale === 'bn' ? 'en' : 'bn')}>{locale === 'bn' ? 'EN' : 'বাংলা'}</a>}
        <button class="search-toggle" id="search-open" aria-label={t(locale, 'nav.search')}>⌕</button>
      </nav>
      <button class="nav-toggle" aria-label="Menu">☰</button>
    </div>
  </div>
  <nav class="mobile-menu">
    {nav.map((n) => (<a href={n.href}>{t(locale, n.key)}</a>))}
    {localized && <a class="lang-switch mobile" href={altHref(locale === 'bn' ? 'en' : 'bn')}>{locale === 'bn' ? 'English' : 'বাংলা'}</a>}
    <button class="search-toggle mobile" id="search-open-mobile">⌕ {t(locale, 'nav.search')}</button>
  </nav>
</header>

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-box">
    <div class="search-field">
      <span aria-hidden="true">⌕</span>
      <input type="text" id="search-input" placeholder="Search laws, articles, jurisdictions…" aria-label="Search hredd.org" autocomplete="off" />
      <button id="search-close" aria-label="Close search">✕</button>
    </div>
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<slot />

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="wordmark" href={homeHref}><b>hredd</b><i>.org</i></a>
        <p class="foot-tag">{tagline}</p>
      </div>
      <div class="foot-col">
        <h4>{t(locale, 'foot.sections')}</h4>
        <a href="/tracker/">{t(locale, 'nav.tracker')}</a><a href="/timeline/">{t(locale, 'nav.timeline')}</a><a href="/trade/">{t(locale, 'foot.tradeExposure')}</a><a href="/buyer-mapping/">{t(locale, 'nav.buyers')}</a><a href="/report/">{t(locale, 'foot.yourReport')}</a><a href="/articles/">{t(locale, 'nav.articles')}</a>
      </div>
      <div class="foot-col">
        <h4>{t(locale, 'foot.brand')}</h4>
        <a href="/about/">{t(locale, 'foot.about')}</a><a href="/methodology/">{t(locale, 'foot.methodology')}</a><a href="/subscribe/">{t(locale, 'foot.subscribe')}</a><a href="/about/#contact">{t(locale, 'foot.contact')}</a>
      </div>
    </div>
    <div class="foot-base">
      <span>© {new Date().getFullYear()} HREDD.org. Developed independently by Vir Viraf Mehta. All rights reserved.</span>
      <span>{t(locale, 'foot.published')}</span>
    </div>
  </div>
</footer>

<script>
  // scroll progress hairline
  const bar = document.createElement('div');
  bar.className = 'progress';
  document.body.appendChild(bar);
  addEventListener('scroll', () => {
    const h = document.documentElement;
    bar.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight || 1)) * 100 + '%';
  }, { passive: true });

  // mobile nav
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.querySelector('.mobile-menu');
  if (toggle && menu) toggle.addEventListener('click', () => {
    menu.classList.toggle('open');
    toggle.textContent = menu.classList.contains('open') ? '✕' : '☰';
  });

  // site search: fetches the prebuilt index once, lazily, on first open, and
  // matches by simple substring against title/sub/text so it works with no
  // backend and stays instant even as the number of laws and articles grows.
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const openBtns = [document.getElementById('search-open'), document.getElementById('search-open-mobile')];
  let index = null, indexPromise = null;

  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json').then(r => r.json()).then(d => { index = d; return d; });
    }
    return indexPromise;
  }

  function openSearch() {
    overlay.hidden = false;
    menu?.classList.remove('open');
    if (toggle) toggle.textContent = '☰';
    loadIndex();
    setTimeout(() => input?.focus(), 30);
  }
  function closeSearch() {
    overlay.hidden = true;
  }

  openBtns.forEach(b => b?.addEventListener('click', openSearch));
  document.getElementById('search-close')?.addEventListener('click', closeSearch);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
  addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && overlay?.hidden) {
      e.preventDefault(); openSearch();
    }
    if (e.key === 'Escape' && !overlay?.hidden) closeSearch();
  });

  function render(items) {
    if (!results) return;
    if (!items.length) {
      results.innerHTML = '<p class="search-empty">No matches. Try a law name, jurisdiction, or topic.</p>';
      return;
    }
    results.innerHTML = items.slice(0, 20).map(i => `
      <a class="search-row" href="${i.href}">
        <span class="search-type mono">${i.type === 'law' ? 'Law' : 'Article'}</span>
        <span class="search-text"><b>${i.title}</b><i>${i.sub}</i></span>
      </a>`).join('');
  }

  input?.addEventListener('input', async () => {
    const q = input.value.trim().toLowerCase();
    if (!q) { results.innerHTML = ''; return; }
    const items = index || await loadIndex();
    const matches = items.filter(i => i.text.includes(q) || i.title.toLowerCase().includes(q));
    render(matches);
  });

  // reveal on scroll
  const io = new IntersectionObserver((es) => {
    for (const e of es) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Numbers render statically. The count-up animation was removed deliberately:
  // animated statistics read as marketing on a site whose brand is sobriety.
</script>
</body>
</html>
