---
import '../styles/global.css';
import { getAllArticles } from '../lib/sanity.js';
import { computeVolIssue } from '../lib/volIssue.js';

const { title = 'hredd.org', description = 'Tracking global HREDD legislation and its implications for those most affected and least consulted.', activePage = '' } = Astro.props;

const articles = await getAllArticles();
const volIssue = computeVolIssue(articles);

const navLinks = [
  { href: '/tracker/', label: 'Tracker', key: 'tracker' },
  { href: '/buyer-mapping/', label: 'Buyer Mapping', key: 'buyer-mapping' },
  { href: '/articles/', label: 'Articles', key: 'articles' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/subscribe/', label: 'Subscribe', key: 'subscribe' }
];

const leftLinks = navLinks.slice(0, 2);
const rightLinks = navLinks.slice(2);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="page-pad">
      <div class="top-strip">
        <span>{volIssue}</span>
        <span class="strip-links">
          <a href="/articles/">Archive</a>
          <a href="/about/#contact">Contact</a>
          <a href="/subscribe/">RSS</a>
        </span>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <div class="nav-left">
          <a href="/" class={activePage === 'home' ? 'active' : ''}>Home</a>
          {leftLinks.map((l) => (
            <a href={l.href} class={activePage === l.key ? 'active' : ''}>{l.label}</a>
          ))}
        </div>
        <div class="nav-lockup">
          <a href="/" class="wordmark" aria-label="hredd.org home">hredd<span class="dot">&middot;</span>org</a>
          <div class="nav-tagline">A Global South perspective</div>
        </div>
        <div class="nav-right">
          {rightLinks.map((l) => (
            <a href={l.href} class={activePage === l.key ? 'active' : ''}>{l.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer page-pad">
      <div>
        <div class="foot-wordmark">hredd<span class="dot">&middot;</span>org</div>
        <p style="margin-top:10px; max-width:340px;">
          Tracking global HREDD legislation and its implications for those most
          affected and least consulted. Established 2026.
        </p>
      </div>
      <nav aria-label="Footer">
        <a href="/tracker/">Tracker</a>
        <a href="/buyer-mapping/">Buyer Mapping</a>
        <a href="/articles/">Articles</a>
        <a href="/about/">About</a>
        <a href="/subscribe/">Subscribe</a>
      </nav>
      <div>
        <p>&copy; {year} hredd.org &middot; Independent &middot; Monthly</p>
        <p style="margin-top:6px;">Published from Noida, India.</p>
      </div>
    </footer>
  </body>
</html>
