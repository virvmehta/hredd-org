---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Supplier exposure report | hredd.org"
  description="Answer eight questions and download a personalised report on how the EUDR and the CSDDD touch your trade, what buyers may demand, and what they may not."
  active="report"
>

<section class="law-head">
  <div class="wrap">
    <p class="kicker reveal">Free · No signup · Nothing leaves your device</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(38px,5.4vw,72px)">Your supplier<br><em>exposure report</em></h1>
    <p class="standfirst reveal" data-delay="2">Eight questions, two minutes, one dated PDF. It explains how the EU Deforestation Regulation and the Corporate Sustainability Due Diligence Directive are likely to touch your trade, what those laws entitle your buyers to ask of you, and what they do not. Your answers never leave this page.</p>
  </div>
</section>

<section class="section" style="padding-top:clamp(40px,5vw,70px)">
  <div class="wrap" style="max-width:820px">

    <form id="rq" novalidate>

      <div class="q reveal" data-n="01">
        <p class="qnum mono">Question 01</p>
        <h3 class="qtitle">Where is your business located?</h3>
        <div class="opts" data-q="country" data-type="single">
          <button type="button" data-v="India">India</button>
          <button type="button" data-v="Bangladesh">Bangladesh</button>
          <button type="button" data-v="Sri Lanka">Sri Lanka</button>
          <button type="button" data-v="Vietnam">Vietnam</button>
          <button type="button" data-v="Indonesia">Indonesia</button>
          <button type="button" data-v="Thailand">Thailand</button>
          <button type="button" data-v="Brazil">Brazil</button>
          <button type="button" data-v="Kenya">Kenya</button>
          <button type="button" data-v="Ethiopia">Ethiopia</button>
          <button type="button" data-v="Other Asia">Other Asia</button>
          <button type="button" data-v="Other Africa">Other Africa</button>
          <button type="button" data-v="Other Latin America">Other Latin America</button>
          <button type="button" data-v="Europe">Europe</button>
          <button type="button" data-v="Other">Other</button>
        </div>
      </div>

      <div class="q reveal" data-n="02">
        <p class="qnum mono">Question 02</p>
        <h3 class="qtitle">Which best describes your business size?</h3>
        <div class="opts" data-q="size" data-type="single">
          <button type="button" data-v="Under 50 workers">Under 50 workers</button>
          <button type="button" data-v="50 to 250 workers">50 to 250 workers</button>
          <button type="button" data-v="250 to 1,000 workers">250 to 1,000 workers</button>
          <button type="button" data-v="Over 1,000 workers">Over 1,000 workers</button>
        </div>
      </div>

      <div class="q reveal" data-n="03">
        <p class="qnum mono">Question 03</p>
        <h3 class="qtitle">Do you produce, process, or trade any of the following, including products made from them?</h3>
        <p class="qhint">Select every one that applies to your trade.</p>
        <div class="opts" data-q="commodities" data-type="multi" data-none="None of these">
          <button type="button" data-v="Cattle or leather">Cattle or leather</button>
          <button type="button" data-v="Cocoa">Cocoa</button>
          <button type="button" data-v="Coffee">Coffee</button>
          <button type="button" data-v="Oil palm">Oil palm</button>
          <button type="button" data-v="Rubber">Rubber</button>
          <button type="button" data-v="Soya">Soya</button>
          <button type="button" data-v="Wood, paper, or furniture">Wood, paper, or furniture</button>
          <button type="button" data-v="None of these">None of these</button>
        </div>
      </div>

      <div class="q reveal" data-n="04">
        <p class="qnum mono">Question 04</p>
        <h3 class="qtitle">Do your goods reach the European Union, directly or through buyers who sell there?</h3>
        <div class="opts" data-q="eu" data-type="single">
          <button type="button" data-v="direct">Yes, we export directly to the EU</button>
          <button type="button" data-v="via">Yes, through intermediaries or buyers who sell into the EU</button>
          <button type="button" data-v="unsure">Not sure</button>
          <button type="button" data-v="no">No EU connection that we know of</button>
        </div>
      </div>

      <div class="q reveal" data-n="05">
        <p class="qnum mono">Question 05</p>
        <h3 class="qtitle">Do any of your buyers have more than roughly 5,000 employees or a turnover above 1.5 billion euro?</h3>
        <div class="opts" data-q="bigbuyer" data-type="single">
          <button type="button" data-v="yes">Yes</button>
          <button type="button" data-v="probably">Probably, they are large multinationals</button>
          <button type="button" data-v="unsure">Not sure</button>
          <button type="button" data-v="no">No, all our buyers are smaller companies</button>
        </div>
      </div>

      <div class="q reveal" data-n="06">
        <p class="qnum mono">Question 06</p>
        <h3 class="qtitle">Have you already received sustainability questionnaires, codes of conduct, or audit requests from buyers?</h3>
        <div class="opts" data-q="questionnaires" data-type="single">
          <button type="button" data-v="freq">Yes, frequently</button>
          <button type="button" data-v="occ">Yes, occasionally</button>
          <button type="button" data-v="none">Not yet</button>
        </div>
      </div>

      <div class="q reveal" data-n="07">
        <p class="qnum mono">Question 07</p>
        <h3 class="qtitle">Do you use labour contractors, recruiters, or intermediaries to engage any part of your workforce?</h3>
        <div class="opts" data-q="contractors" data-type="single">
          <button type="button" data-v="yes">Yes</button>
          <button type="button" data-v="no">No</button>
          <button type="button" data-v="seasonal">Sometimes, seasonally</button>
        </div>
      </div>

      <div class="q reveal" data-n="08">
        <p class="qnum mono">Question 08</p>
        <h3 class="qtitle">Do you currently hold any of the following certifications or verified memberships?</h3>
        <p class="qhint">Select every scheme you currently hold.</p>
        <div class="opts" data-q="certs" data-type="multi" data-none="None currently">
          <button type="button" data-v="Bonsucro">Bonsucro</button>
          <button type="button" data-v="Rainforest Alliance">Rainforest Alliance</button>
          <button type="button" data-v="Fairtrade">Fairtrade</button>
          <button type="button" data-v="SA8000">SA8000</button>
          <button type="button" data-v="SMETA audit through Sedex">SMETA (Sedex)</button>
          <button type="button" data-v="amfori BSCI">amfori BSCI</button>
          <button type="button" data-v="Better Cotton">Better Cotton</button>
          <button type="button" data-v="GOTS or OEKO-TEX">GOTS / OEKO-TEX</button>
          <button type="button" data-v="FSC or PEFC">FSC / PEFC</button>
          <button type="button" data-v="ISO 14001 or ISO 45001">ISO 14001 / 45001</button>
          <button type="button" data-v="WRAP">WRAP</button>
          <button type="button" data-v="another recognised scheme">Another scheme</button>
          <button type="button" data-v="None currently">None currently</button>
        </div>
      </div>

      <div class="gen-row reveal">
        <button type="button" class="btn solid" id="gen"><span>Generate my report</span> <i>→</i></button>
        <p class="mono faint" id="gen-msg" style="margin:14px 0 0"></p>
      </div>
    </form>

    <div class="ring" id="ring" title="Answered so far" role="progressbar" aria-label="Questions answered">
      <svg viewBox="0 0 74 74" aria-hidden="true">
        <circle cx="37" cy="37" r="33"></circle>
        <circle class="fill" cx="37" cy="37" r="33"></circle>
      </svg>
      <span class="rlabel" id="rlabel">0/8</span>
    </div>

    <div id="result" hidden>
      <div class="dossier-head reveal in">
        <p class="dh-kicker">hredd.org · prepared without transmission · nothing stored</p>
        <h2 class="dh-title">Supplier <em>exposure report</em></h2>
        <div class="dh-meta">
          <span>Dated <b id="dh-date"></b></span>
          <span>Regimes <b>EUDR · CSDDD</b></span>
          <span>Status <b>verified against tracker</b></span>
        </div>
        <div class="dh-mark" aria-hidden="true">
          <span class="dh-word">hredd<em>.org</em></span>
          <span class="dh-rule"></span>
          <span class="dh-sub">supplier exposure report</span>
        </div>
      </div>
      <div class="result-bar">
        <p class="kicker">Your report is ready</p>
        <button type="button" class="btn solid" id="dl"><span>Download PDF</span> <i>↓</i></button>
      </div>
      <div class="prose" id="preview"></div>
    </div>

  </div>
</section>

<style>
  /* ---- question dossier ---- */
  .q{ position:relative; padding:44px 0 40px; border-bottom:1px solid var(--line-soft); }
  .q::after{ content:attr(data-n); position:absolute; right:0; top:26px;
    font:400 clamp(64px,8vw,110px)/1 var(--serif); color:var(--ink);
    opacity:.045; pointer-events:none; letter-spacing:-.02em;
    transition:opacity .5s, color .5s; }
  .q.done::after{ color:var(--gold); opacity:.14; }
  .q.missing::after{ color:var(--st-delayed); opacity:.18; }
  .qnum{ color:var(--gold); font-size:10px; letter-spacing:.24em; margin:0 0 12px;
    display:flex; align-items:center; gap:12px; }
  .qnum::after{ content:""; height:1px; flex:0 0 34px; background:var(--gold-dim);
    transform:scaleX(0); transform-origin:left; transition:transform .5s cubic-bezier(.16,1,.3,1); }
  .q.done .qnum::after{ transform:scaleX(1); }
  .qtitle{ font:400 clamp(22px,2.4vw,27px)/1.35 var(--serif); margin:0 0 20px; max-width:56ch; }
  .qhint{ margin:-10px 0 20px; font-size:14px; color:var(--ink-faint); font-style:italic; }
  .q.missing .qtitle{ color:var(--st-delayed); }

  /* ---- selection chips: diamond markers, gold sweep ---- */
  .opts{ display:flex; flex-wrap:wrap; gap:10px; }
  .opts button{ font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase;
    border:1px solid var(--line); background:none; color:var(--ink-dim); padding:13px 20px;
    cursor:pointer; display:inline-flex; align-items:center; gap:11px;
    position:relative; overflow:hidden; transition:border-color .3s, color .3s; }
  .opts button::before{ content:""; width:6px; height:6px; flex:0 0 6px;
    border:1px solid var(--ink-faint); transform:rotate(45deg);
    transition:background .3s, border-color .3s, box-shadow .3s; }
  .opts button::after{ content:""; position:absolute; inset:0; background:var(--gold-ghost);
    transform:scaleX(0); transform-origin:left; transition:transform .35s cubic-bezier(.16,1,.3,1); z-index:-1; }
  .opts button:hover{ border-color:var(--gold-dim); color:var(--ink); }
  .opts button:focus-visible{ outline:1px solid var(--gold); outline-offset:2px; }
  .opts button.on{ border-color:var(--gold); color:var(--gold-hi); }
  .opts button.on::before{ background:var(--gold); border-color:var(--gold); box-shadow:0 0 8px var(--gold); }
  .opts button.on::after{ transform:scaleX(1); }

  /* ---- progress ring ---- */
  .ring{ position:fixed; right:clamp(16px,3vw,40px); bottom:clamp(16px,3vw,40px); z-index:90;
    width:74px; height:74px; cursor:pointer; opacity:0; transform:translateY(12px);
    transition:opacity .5s, transform .5s; }
  .ring.show{ opacity:1; transform:none; }
  .ring svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .ring circle{ fill:rgba(14,13,10,.85); stroke:var(--line); stroke-width:1.5; }
  .ring circle.fill{ fill:none; stroke:var(--gold); stroke-width:1.5;
    stroke-dasharray:207; stroke-dashoffset:207;
    transition:stroke-dashoffset .6s cubic-bezier(.16,1,.3,1);
    filter:drop-shadow(0 0 6px var(--gold-ghost)); }
  .ring .rlabel{ position:absolute; inset:0; display:grid; place-items:center;
    font-family:var(--mono); font-size:12px; letter-spacing:.12em; color:var(--ink-dim); }
  .ring.full .rlabel{ color:var(--gold-hi); }

  /* ---- generate row ---- */
  .gen-row{ padding:54px 0 10px; display:flex; flex-direction:column; align-items:flex-start; gap:0; }
  #gen-msg{ margin:16px 0 0; color:var(--st-delayed); }

  /* ---- the dossier ---- */
  #result{ margin-top:clamp(50px,7vw,90px); }
  .dossier-head{ border:1px solid var(--gold-dim); background:
    radial-gradient(140% 160% at 50% -30%, var(--panel-2), var(--bg) 70%);
    padding:clamp(30px,4vw,50px); position:relative; overflow:hidden; margin-bottom:clamp(36px,5vw,60px); }
  .dossier-head::before{ content:""; position:absolute; inset:6px; border:1px solid var(--line-soft);
    pointer-events:none; }
  .dh-kicker{ font-family:var(--mono); font-size:10px; letter-spacing:.26em; text-transform:uppercase;
    color:var(--gold); margin:0 0 16px; }
  .dh-title{ font:400 clamp(30px,4vw,46px)/1.1 var(--serif); margin:0; letter-spacing:-.01em; }
  .dh-title em{ font-style:italic; color:var(--gold-hi); }
  .dh-meta{ margin-top:22px; display:flex; gap:26px; flex-wrap:wrap;
    font-family:var(--mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-faint); }
  .dh-meta b{ color:var(--ink-dim); font-weight:400; }
  .dh-mark{ position:absolute; right:clamp(24px,4vw,48px); top:50%; transform:translateY(-50%);
    text-align:right; }
  .dh-word{ display:block; font:400 clamp(22px,2.6vw,30px)/1 var(--serif); color:var(--ink);
    letter-spacing:-.01em; }
  .dh-word em{ font-style:normal; font-size:.62em; color:var(--ink-faint); }
  .dh-rule{ display:block; height:1.5px; background:var(--gold); margin:7px 0 9px auto; width:100%; }
  .dh-sub{ display:block; font-family:var(--mono); font-weight:500; font-size:8.5px;
    letter-spacing:.14em; text-transform:uppercase; color:var(--ink-faint); }
  @media (max-width:640px){ .dh-mark{ display:none; } }
  .result-bar{ display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap;
    padding:0 0 34px; margin:0 0 34px; border-bottom:1px solid var(--line); }
  #preview h2{ font:400 30px/1.25 var(--serif); margin:2em 0 .6em; color:var(--gold-hi);
    padding-top:1.2em; border-top:1px solid var(--line-soft); }
  #preview h2::before{ content:"◆"; color:var(--gold-dim); font-size:9px; display:block; margin-bottom:14px; }
  #preview h3{ font:400 22px/1.3 var(--serif); margin:1.7em 0 .5em; }
</style>

<script>
import { jsPDF } from 'jspdf';
/* ---------------- form state ---------------- */
const answers = { country:null, size:null, commodities:[], eu:null, bigbuyer:null, questionnaires:null, contractors:null, certs:[] };

document.querySelectorAll('.opts').forEach(group => {
  const q = group.dataset.q, type = group.dataset.type, noneVal = group.dataset.none;
  group.addEventListener('click', e => {
    const b = e.target.closest('button'); if(!b) return;
    const v = b.dataset.v;
    if(type === 'single'){
      group.querySelectorAll('button').forEach(x => x.classList.remove('on'));
      b.classList.add('on'); answers[q] = v;
    } else {
      if(v === noneVal){
        group.querySelectorAll('button').forEach(x => x.classList.remove('on'));
        b.classList.add('on'); answers[q] = [noneVal];
      } else {
        group.querySelector(`button[data-v="${noneVal}"]`)?.classList.remove('on');
        answers[q] = answers[q].filter(x => x !== noneVal);
        b.classList.toggle('on');
        if(b.classList.contains('on')) answers[q].push(v);
        else answers[q] = answers[q].filter(x => x !== v);
      }
    }
    const qEl = group.closest('.q');
    qEl.classList.remove('missing');
    const filled = type === 'multi' ? answers[q].length > 0 : !!answers[q];
    qEl.classList.toggle('done', filled);
    updateRing();
  });
});

/* ---------------- progress ring ---------------- */
const ringEl = document.getElementById('ring');
const ringFill = ringEl.querySelector('.fill');
const ringLabel = document.getElementById('rlabel');
const CIRC = 207;
function answeredCount(){
  let n = 0;
  for(const k of ['country','size','eu','bigbuyer','questionnaires','contractors']) if(answers[k]) n++;
  for(const k of ['commodities','certs']) if(answers[k].length) n++;
  return n;
}
function updateRing(){
  const n = answeredCount();
  ringFill.style.strokeDashoffset = String(CIRC - (CIRC * n / 8));
  ringLabel.textContent = n + '/8';
  ringEl.classList.toggle('show', n > 0 && n < 8 || n === 8 && document.getElementById('result').hidden);
  ringEl.classList.toggle('full', n === 8);
  if(n === 8) ringLabel.textContent = '✦';
}
ringEl.addEventListener('click', () => {
  const target = [...document.querySelectorAll('.q')].find(q => !q.classList.contains('done'));
  (target || document.getElementById('gen')).scrollIntoView({ behavior:'smooth', block:'center' });
});

/* ---------------- report content ---------------- */
const TODAY = new Date().toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' });

function buildReport(a){
  const S = [];
  const add = (h, ps, level=2) => S.push({ h, ps, level });

  const hasCom = a.commodities.length > 0 && !a.commodities.includes('None of these');
  const coms = a.commodities.filter(c => c !== 'None of these');
  const eudr = hasCom && ['direct','via','unsure'].includes(a.eu);
  const eudrDirect = hasCom && a.eu === 'direct';
  const csddd = ['yes','probably','unsure'].includes(a.bigbuyer);
  const inter = ['yes','seasonal'].includes(a.contractors);
  const certs = a.certs.filter(c => c !== 'None currently');
  const hasCerts = certs.length > 0;
  const asked = ['freq','occ'].includes(a.questionnaires);

  /* ---- 1. The verdict, stated in three lines ---- */
  const verdict = [];
  if(eudr){
    verdict.push(`Because you trade ${coms.join(' and ').toLowerCase()} and your goods reach the European Union, the EU Deforestation Regulation reaches your consignments directly. Your buyers cannot file their due diligence statements without plot coordinates from you, so the demand is unavoidable rather than negotiable.`);
  } else if(hasCom){
    verdict.push(`You trade ${coms.join(' and ').toLowerCase()}, which the EUDR covers, but you report no EU connection, so the regulation is unlikely to reach you today. Visibility past a first buyer is rarely complete, and the request can still arrive.`);
  } else {
    verdict.push('None of your products fall inside the EUDR\u2019s seven commodities, so that regulation does not apply to your trade at all. Buyers occasionally send EUDR questionnaires across their whole supplier base regardless, and you are entitled to say so.');
  }
  if(csddd){
    verdict.push('Your buyers are large enough that the CSDDD reaches you through their contracts rather than through law. No authority can sanction you under it, which means every obligation you take on arrives as a contract term, and contract terms are negotiable.');
  } else {
    verdict.push('Your buyers sit below the CSDDD thresholds, so direct contractual cascade is unlikely today. Mid-sized buyers increasingly mirror the demands their own larger customers make of them, so the questions still travel.');
  }
  add('Where you stand', verdict, 1);

  /* ---- 2. What to do, the whole point of the report ---- */
  const actions = [];
  if(eudr){
    actions.push('Start collecting plot geolocation for every farm you source from, with farmer consent, before a buyer asks. Single plots need one coordinate, anything above four hectares needs polygon boundaries, and gathering this after the request is materially harder than gathering it before.');
    actions.push('Assemble your legality file now: land use rights, environmental permits, labour compliance, and tax records under your own national law. The EUDR requires legal production as well as deforestation-free production, and the second half is where most suppliers are caught unprepared.');
  }
  if(csddd){
    actions.push('Read the VSME standard, because it is the boundary of what a buyer should reasonably ask a smaller partner, and knowing its data points by name is worth more than knowing any single buyer\u2019s questionnaire format.');
    actions.push('Write a one-page description of your grievance mechanism. It is the single most requested item across every framework, and almost no supplier has one ready.');
  }
  if(inter){
    actions.push('Document your labour contractors now: written agreements covering wages and deductions, evidence that wages reach workers rather than stopping with the intermediary, and attestations that no worker paid a recruitment fee. Recruitment channels attract the closest scrutiny of any topic in due diligence, so this converts your most examined subject into your best documented one.');
  }
  if(!hasCerts){
    actions.push('Consider a recognised certification. Whatever its limits, it now carries procedural weight under the amended CSDDD, because buyers must use information already reasonably available before questioning you further, and a live certification is exactly such information.');
  }
  if(actions.length) add('What to do before they ask', actions, 1);

  /* ---- 3. What you can push back on ---- */
  const pushback = [];
  if(eudr){
    pushback.push('No certificate is an EUDR requirement. Buyers may use one to support their risk assessment, but no scheme discharges the regulation, and a buyer claiming otherwise is mistaken. The EUDR also gives no right to unannounced access, and no right to pricing or customer information unrelated to traceability.');
  }
  if(csddd){
    pushback.push('Under Article 8(4) of the amended CSDDD, a buyer must scope risk from information already reasonably available, and may seek more from a partner under 5,000 employees only as a last resort, where it is necessary and cannot be obtained otherwise, with each request targeted, reasonable and proportionate. Separately, CSRD reporters may not ask partners under 1,000 employees for more than the VSME standard specifies.');
    if(hasCerts){
      pushback.push(`You hold ${certs.join(', ')}. When a questionnaire duplicates ground your certification already covers, present the certification first and ask which specific necessary information it fails to provide. The burden of naming that gap now sits with the buyer. Two limits are honest: a buyer facing a specifically reported risk can still make targeted requests, and the EUDR accepts certificates as supporting information only, never as a substitute for coordinates.`);
    }
    pushback.push('The directive does not require you to absorb the cost of the buyer\u2019s compliance programme, and its own provisions recognise that buyer pricing and payment practices are part of the risk picture rather than outside it.');
  }
  if(pushback.length) add(asked ? 'What you can push back on, and you have been asked already' : 'What you can push back on', pushback, 1);

  /* ---- 4. Dates ---- */
  const dates = [];
  if(eudr) dates.push('EUDR: application was postponed a second time one week before it began, so large operators now start on 30 December 2026 and micro and small enterprises on 30 June 2027. Buyer requests typically run one to two seasons ahead of the buyer\u2019s own filing deadline, so the demands arrive regardless.');
  if(csddd) dates.push('CSDDD: entered into force 18 March 2026, national transposition by 26 July 2028, obligations apply from 26 July 2029. Commission model contract clauses are due by 26 July 2027 and will likely become the template your buyers put in front of you.');
  if(dates.length) add('The dates that matter', dates, 1);

  /* ---- 5. Close ---- */
  add('Keeping this current', [
    `This report reflects the hredd.org tracker on ${TODAY}. These laws moved repeatedly in the last year and will move again, and regenerating this takes two minutes. The monthly digest covers every movement as it happens, from the supplier side of the chain.`
  ], 1);

  add('Sources and standing', [
    'General information prepared from public legal texts, not legal advice, and not an assessment of your compliance. Verify against the primary sources: EUDR, Regulation (EU) 2023/1115, at eur-lex.europa.eu/eli/reg/2023/1115/oj. CSDDD, Directive (EU) 2024/1760 as amended by Directive (EU) 2026/470, at eur-lex.europa.eu/eli/dir/2024/1760/oj. The full tracker is at hredd.org/tracker.'
  ], 1);

  return S;
}

/* ---------------- generate + preview ---------------- */
let currentReport = null;

document.getElementById('gen').addEventListener('click', () => {
  const missing = [];
  document.querySelectorAll('.opts').forEach(g => {
    const q = g.dataset.q;
    const empty = g.dataset.type === 'multi' ? answers[q].length === 0 : !answers[q];
    g.closest('.q').classList.toggle('missing', empty);
    if(empty) missing.push(q);
  });
  const msg = document.getElementById('gen-msg');
  if(missing.length){
    msg.textContent = 'Please answer the highlighted questions above.';
    document.querySelector('.q.missing').scrollIntoView({ behavior:'smooth', block:'center' });
    return;
  }
  msg.textContent = '';
  const genBtn = document.getElementById('gen');
  genBtn.querySelector('span').textContent = 'Compiling…';
  genBtn.disabled = true;
  currentReport = buildReport(answers);
  document.getElementById('dh-date').textContent = TODAY;

  const pv = document.getElementById('preview');
  pv.innerHTML = '';
  currentReport.forEach(sec => {
    if(sec.h){
      const h = document.createElement(sec.level === 1 ? 'h2' : 'h3');
      h.textContent = sec.h; pv.appendChild(h);
    }
    sec.ps.forEach(t => {
      const p = document.createElement('p'); p.textContent = t; pv.appendChild(p);
    });
  });
  setTimeout(() => {
    const r = document.getElementById('result');
    r.hidden = false;
    ringEl.classList.remove('show');
    genBtn.querySelector('span').textContent = 'Regenerate report';
    genBtn.disabled = false;
    r.scrollIntoView({ behavior:'smooth', block:'start' });
  }, 550);
});

/* ---------------- PDF ---------------- */
document.getElementById('dl').addEventListener('click', () => {
  if(!currentReport) return;
  const doc = new jsPDF({ unit:'mm', format:'a4' });
  const W = 210, M = 22, maxW = W - M * 2, bottom = 275;
  let y = 0;

  const newPage = () => { doc.addPage(); y = 24; foot(); };
  const foot = () => {
    doc.setFont('courier','normal'); doc.setFontSize(7); doc.setTextColor(140);
    doc.text('hredd.org  ·  supplier exposure report  ·  ' + TODAY, M, 288);
    doc.setTextColor(30);
  };
  const ensure = need => { if(y + need > bottom) newPage(); };

  /* masthead */
  y = 26;
  doc.setFont('times','normal'); doc.setFontSize(26); doc.setTextColor(30);
  doc.text('hredd.org', M, y);
  doc.setFont('courier','normal'); doc.setFontSize(8); doc.setTextColor(120);
  doc.text('SUPPLIER EXPOSURE REPORT  ·  ' + TODAY.toUpperCase(), M, y + 7);
  doc.setDrawColor(180); doc.setLineWidth(.3); doc.line(M, y + 12, W - M, y + 12);
  doc.setTextColor(30);
  y += 24; foot();

  currentReport.forEach(sec => {
    if(sec.h){
      const size = sec.level === 1 ? 15 : 12;
      ensure(14);
      doc.setFont('times', sec.level === 1 ? 'normal' : 'italic'); doc.setFontSize(size);
      const hl = doc.splitTextToSize(sec.h, maxW);
      doc.text(hl, M, y); y += hl.length * (size * .45) + 3;
    }
    doc.setFont('times','normal'); doc.setFontSize(10.5);
    sec.ps.forEach(t => {
      const lines = doc.splitTextToSize(t, maxW);
      const lineH = 4.9;
      let idx = 0;
      while(idx < lines.length){
        ensure(lineH);
        const fit = Math.min(lines.length - idx, Math.floor((bottom - y) / lineH) || 1);
        doc.text(lines.slice(idx, idx + fit), M, y);
        y += fit * lineH; idx += fit;
      }
      y += 3;
    });
    y += sec.level === 1 ? 4 : 2;
  });

  doc.save('hredd-supplier-exposure-report.pdf');
});
</script>

