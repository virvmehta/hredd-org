---
/**
 * Legacy route preserved from the first build. Buyer compliance
 * mapping now lives at /buyer-mapping/ and this page redirects there.
 */
const target = '/buyer-mapping/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body style="background:#0e0d0a; color:#eae4d5; font-family:Georgia,serif; display:grid; place-items:center; min-height:100vh;">
    <p>This page has moved. Continue to <a href={target}>buyer compliance mapping</a>.</p>
  </body>
</html>
