---
import Base from '../../layouts/Base.astro';
import { getAllLaws } from '../../lib/sanity.js';
import data from '../../../public/data/trade-exposure.json';

const allLaws = await getAllLaws();
const lawBySlug = Object.fromEntries(allLaws.map(l => [l.slug, l]));

const MARKET_LABELS = { EU27: 'European Union', USA: 'United States', GBR: 'United Kingdom',
  CHE: 'Switzerland', NOR: 'Norway', CAN: 'Canada', AUS: 'Australia', JPN: 'Japan', KOR: 'South Korea' };

const pct = v => { const p = v * 100; return (p >= 10 ? p.toFixed(0) : p >= 1 ? p.toFixed(1) : '<1') + '%'; };
const usd = v => v >= 1e9 ? '$' + (v/1e9).toFixed(v >= 1e10 ? 0 : 1) + 'bn' : '$' + Math.max(1, Math.round(v/1e6)) + 'M';
const yearOf = d => d ? d.slice(0, 4) : '';

const countries = Object.entries(data.countries).map(([slug, c]) => ({ slug, ...c }));
const DEFAULT = 'bangladesh';

// Distinct categorical colours for the destination bar, one per market, so the
// segments read as separate regions rather than one gold gradient. Validated
// for colour-vision separation and contrast on the dark surface (dataviz
// skill), with the gaps and legend swatches below as the second cue.
const DEST_COLOURS = ['#e0b04a', '#4fa26a', '#5f86cc', '#d9663e', '#b884c9'];
const DEST_OTHER = '#5c574d';

function ledgerOf(c){
  const rows = [], quiet = [];
  for(const [slug, r] of Object.entries(c.regimes_2030)){
    const law = lawBySlug[slug];
    if(!law) continue;
    if(r.class === 'C' || !r.share || r.share[2] === 0){
      quiet.push({ slug, law, r });
    } else {
      rows.push({ slug, law, r });
    }
  }
  rows.sort((a, b) => b.r.share[1] - a.r.share[1] || b.r.share[2] - a.r.share[2]);
  quiet.sort((a, b) => (a.r.class === 'C' ? 1 : 0) - (b.r.class === 'C' ? 1 : 0));
  return { rows, quiet };
}
---
<Base
  title="The Regulated Trade Index | hredd.org"
  description="How each country's exports pass through the tracked regimes: share of value in scope, published bands, statutory dates, and open methodology."
  active="trade"
>

{data.sample_data && (
  <div class="sample-banner">
    <div class="wrap mono">Illustrative sample data, pending the first live pipeline run · not real trade statistics · <a href="/methodology/">methodology</a></div>
  </div>
)}

<section class="law-head">
  <div class="wrap">
    <p class="kicker reveal">Exposure by country, measured from customs data</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.4vw,78px)">The Regulated<br><em>Trade Index</em></h1>
    <p class="standfirst reveal" data-delay="2">Choose a country to see how much of its export trade each law reaches, from today out to 2030. Every figure is computed from public customs data and links to its working.</p>
  </div>
</section>

<section class="section" style="padding-top:clamp(36px,4vw,56px)">
  <div class="wrap">

    <div class="cchips reveal" role="tablist" aria-label="Country">
      {countries.map(c => (
        <button class={`cchip${c.slug === DEFAULT ? ' on' : ''}`} data-c={c.slug} role="tab" aria-selected={c.slug === DEFAULT ? 'true' : 'false'}>{c.name}</button>
      ))}
    </div>

    {countries.map(c => { const { rows, quiet } = ledgerOf(c); const end = c.series[c.series.length - 1];
      const top5 = c.markets.slice(0, 5);
      const otherShare = Math.max(0, 1 - top5.reduce((s, m) => s + m.share, 0)); return (
      <div class="cpane" data-c={c.slug} hidden={c.slug !== DEFAULT}>

        <p class="takeaway reveal">By 2030, {pct(end.union)} of {c.name}'s exports to these tracked markets fall in scope of at least one law.</p>

        <div class="stats" style="margin-top:34px">
          <div class="stat"><b>{usd(c.total_exports_usd)}</b><span>Total exports per year</span></div>
          <div class="stat"><b>{c.laws_touching}<span style="font-size:.5em; color:var(--ink-faint)"> / 18</span></b><span>Laws touch its trade</span></div>
          <div class="stat"><b>{pct(end.union)}</b><span>Of export value in scope of at least one law by 2030</span></div>
          <div class="stat"><b>{pct(end.border)}</b><span>Stoppable at a border by 2030</span></div>
        </div>
        <p class="scope-note mono">Figures cover only the nine markets where tracked HREDD laws apply: the EU, US, UK, Canada, Australia, Japan, South Korea, Norway and Switzerland. This is not {c.name}'s total exports to the world.</p>

        <div class="destbar-wrap">
          <div class="destbar" role="img" aria-label="Share of exports by destination market">
            {top5.map((m, i) => (
              <i style={`width:${(m.share*100).toFixed(2)}%; background:${DEST_COLOURS[i]}`}></i>
            ))}
            <i style={`width:${(otherShare*100).toFixed(2)}%; background:${DEST_OTHER}`}></i>
          </div>
          <div class="destlegend mono">
            {top5.map((m, i) => (
              <span><em style={`background:${DEST_COLOURS[i]}`}></em>{MARKET_LABELS[m.key] || m.key} {Math.round(m.share*100)}%</span>
            ))}
            <span class="faint"><em style={`background:${DEST_OTHER}`}></em>Other destinations {Math.round(otherShare*100)}%</span>
          </div>
        </div>

        <div class="class-legend mono">
          <p>Every figure below carries a class that says how much guesswork sits behind it. <b>Class A</b> means the law lists exactly which products and markets it covers, so we measured the trade directly. <b>Class B</b> means the law's reach depends on who the buyer is, so we estimated it from a published assumption and show a range. <b>Class C</b> means customs data cannot produce an honest number, so we refuse to show one.</p>
        </div>

        <div class="ledger-head mono">
          <span>Law</span><span class="lh-status">Status</span><span class="lh-from">From</span>
          <span>Share of export value in scope</span><span class="lh-share">Central</span><span class="lh-val">Value</span><span class="lh-class">Class</span>
        </div>

        <div class="ledger">
          {rows.map(({ slug, law, r }) => { const [lo, ce, hi] = r.share; const max = rows[0].r.share[2] || 1;
            const rangeTitle = r.class === 'B' ? `Central estimate ${pct(ce)}. Could reach up to ${pct(hi)} depending on buyer size.` : `${pct(ce)}, measured directly.`; return (
            <a class="lrow" href={`/laws/${slug}/`}>
              <div class="l-name">
                <h3>{law.shortName || law.name}</h3>
                <p>{law.name} · {MARKET_LABELS[r.market] || r.market}</p>
              </div>
              <span class="chip" data-g={law.statusType}>{law.status}</span>
              <span class="mono l-from">{yearOf(r.first_date)}</span>
              <span class="l-band" title={rangeTitle}>
                <i class="central" style={`width:${ce/max*100}%`}></i>
              </span>
              <span class="mono l-share" title={rangeTitle}>{pct(ce)}</span>
              <span class="mono l-val">{usd(r.value[1])}</span>
              <span class="cbadge" data-cl={r.class}>{r.class}</span>
            </a>
          );})}
        </div>

        {quiet.length > 0 && (
          <div class="quiet">
            <p class="kicker" style="margin:44px 0 14px">Unquantified or not yet reaching this trade</p>
            {quiet.map(({ slug, law, r }) => (
              <a class="lrow qrow" href={`/laws/${slug}/`}>
                <div class="l-name"><h3>{law.shortName || law.name}</h3><p>{law.name}</p></div>
                <span class="chip" data-g={law.statusType}>{law.status}</span>
                <span class="mono faint l-note">{r.class === 'C' ? 'Not quantifiable in customs data' : (!r.first_date ? 'Awaiting entry into force, no fixed date' : 'No measured flows in scope')}</span>
                <span class="cbadge" data-cl={r.class || 'B'}>{r.class || 'B'}</span>
              </a>
            ))}
          </div>
        )}

      </div>
    );})}

    <p class="mono faint" style="margin-top:30px">Shares at full application of current law · Per-law shares intentionally sum past the union figure · Dataset {data.dataset_version} · <a href="/methodology/" style="color:var(--gold)">full methodology and open data</a></p>

  </div>
</section>

<style>
  .sample-banner{ background:var(--gold-ghost); border-bottom:1px solid var(--gold-dim); }
  .sample-banner .wrap{ padding-top:10px; padding-bottom:10px; color:var(--gold-hi); font-size:10px; letter-spacing:.18em; }
  .sample-banner a{ color:var(--gold-hi); text-decoration:underline; }

  .cchips{ display:flex; flex-wrap:wrap; gap:9px; }
  .cchip{ font-family:var(--mono); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    border:1px solid var(--line); background:none; color:var(--ink-dim); padding:10px 16px; cursor:pointer;
    transition:all .3s; }
  .cchip:hover{ border-color:var(--gold-dim); color:var(--ink); }
  .cchip.on{ border-color:var(--gold); color:var(--gold-hi); background:var(--gold-ghost); }

  .takeaway{ font:400 clamp(20px,2.2vw,26px)/1.5 var(--serif); color:var(--ink);
    max-width:56ch; margin:38px 0 0; }

  .scope-note{ margin:14px 0 0; font-size:11px; letter-spacing:.06em; line-height:1.7;
    color:var(--ink-dim); text-transform:none; max-width:62ch; }

  .class-legend{ margin-top:44px; padding:16px 18px; border:1px solid var(--line-soft);
    background:var(--bg-raise); }
  .class-legend p{ margin:0; font-size:11px; letter-spacing:.08em; line-height:1.9;
    color:var(--ink-dim); text-transform:none; }
  .class-legend b{ color:var(--gold-hi); font-weight:500; }

  .destbar-wrap{ margin:34px 0 8px; }
  /* 2px flex gaps let the background show between segments, so adjacent
     markets never merge into one another. */
  .destbar{ display:flex; gap:2px; height:13px; background:var(--bg-raise);
    border:1px solid var(--line-soft); overflow:hidden; }
  .destbar i{ display:block; min-width:1px; }
  .destlegend{ display:flex; flex-wrap:wrap; gap:18px; margin-top:12px; font-size:11px;
    letter-spacing:.14em; color:var(--ink-dim); align-items:center; }
  .destlegend em{ display:inline-block; width:11px; height:11px; margin-right:8px;
    vertical-align:-1px; font-style:normal; }
  .destlegend .faint{ color:var(--ink-faint); }

  .ledger-head{ display:grid; grid-template-columns:minmax(0,1.5fr) 118px 52px minmax(0,1.6fr) 92px 74px 44px;
    gap:16px; align-items:center; padding:26px 0 12px; border-bottom:1px solid var(--line);
    font-size:10.5px; letter-spacing:.14em; color:var(--ink-dim); text-transform:uppercase; }
  .lrow{ display:grid; grid-template-columns:minmax(0,1.5fr) 118px 52px minmax(0,1.6fr) 92px 74px 44px;
    gap:16px; align-items:center; padding:15px 0; border-bottom:1px solid var(--line-soft);
    text-decoration:none; transition:background .2s; }
  .lrow:hover{ background:var(--gold-ghost); }
  .l-name h3{ font:400 17px/1.25 var(--serif); color:var(--ink); margin:0; }
  .l-name p{ margin:3px 0 0; font-size:12px; color:var(--ink-faint); }
  .l-from{ font-size:11px; color:var(--ink-dim); }
  /* Single bar, single number: the class badge already explains that a B
     figure is a central estimate with an upper ceiling (see the legend and
     the tooltip on hover), so the row itself no longer overlays a second
     band or stacks a second percentage under the first. */
  .l-band{ position:relative; height:8px; background:var(--panel-2); display:block; }
  .l-band .central{ position:absolute; left:0; top:1px; bottom:1px;
    background:linear-gradient(90deg,var(--gold-dim),var(--gold)); }
  .l-share{ font-size:14px; font-weight:500; color:var(--gold-hi); text-align:right;
    white-space:nowrap; }
  .l-val{ font-size:11px; color:var(--ink-dim); text-align:right; white-space:nowrap; }
  .cbadge{ font-family:var(--mono); font-size:9.5px; letter-spacing:.1em; text-align:center;
    border:1px solid var(--line); color:var(--ink-dim); padding:5px 0; }
  .cbadge[data-cl="A"]{ border-color:var(--gold-dim); color:var(--gold-hi); }
  .cbadge[data-cl="C"]{ color:var(--ink-faint); border-style:dashed; }
  .qrow{ grid-template-columns:minmax(0,1.5fr) 130px minmax(0,1fr) 44px; opacity:.72; }
  .qrow .chip{ justify-self:start; }
  .l-note{ font-size:11px; letter-spacing:.08em; padding-left:4px; }

  @media (max-width:880px){
    .ledger-head{ display:none; }
    .lrow{ grid-template-columns:minmax(0,1fr) auto; grid-template-areas:"name status" "band band" "share val"; }
    .l-name{ grid-area:name; } .lrow .chip{ grid-area:status; justify-self:end; }
    .l-band{ grid-area:band; } .l-share{ grid-area:share; text-align:left; }
    .l-val{ grid-area:val; } .l-from,.cbadge{ display:none; }
    .qrow{ grid-template-areas:"name status" "note note"; }
    .l-note{ grid-area:note; }
  }
</style>

<script>
  const chips = document.querySelectorAll('.cchip');
  const panes = document.querySelectorAll('.cpane');
  function show(slug){
    chips.forEach(ch => { const on = ch.dataset.c === slug; ch.classList.toggle('on', on); ch.setAttribute('aria-selected', String(on)); });
    panes.forEach(p => { p.hidden = p.dataset.c !== slug; });
    history.replaceState(null, '', '#' + slug);
  }
  chips.forEach(ch => ch.addEventListener('click', () => show(ch.dataset.c)));
  const h = location.hash.slice(1);
  if(h && document.querySelector(`.cpane[data-c="${h}"]`)) show(h);
</script>

</Base>
