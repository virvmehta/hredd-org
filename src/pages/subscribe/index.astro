---
import Base from '../../layouts/Base.astro';

const blurb =
  'Each issue covers what changed, what it means for your orders, and what to prepare before your buyers ask.';
---
<Base
  title="Subscribe | hredd.org"
  description="Subscribe to the hredd.org monthly digest: every HREDD movement, from the supplier side of the chain."
  active="subscribe"
>

<section class="section sub-band" style="min-height:56vh; display:grid; align-items:center">
  <div class="wrap">
    <p class="kicker reveal" style="justify-content:center">The monthly digest</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.6vw,80px)">One monthly briefing on<br /><em>everything that moved</em></h1>
    <p class="standfirst reveal" data-delay="2" style="margin:26px auto 0">{blurb}</p>
    <form class="sub-form reveal" data-delay="3" action="https://buttondown.com/api/emails/embed-subscribe/hredd" method="post" target="_blank">
      <input type="email" name="email" placeholder="you@example.org" required aria-label="Email address" />
      <button class="btn solid" type="submit"><span>Subscribe</span></button>
    </form>
    <p class="form-note reveal" data-delay="3">Monthly · Free · Unsubscribe anytime · We use your email only to send the letter</p>
  </div>
</section>

</Base>
