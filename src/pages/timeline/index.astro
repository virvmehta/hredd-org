---
import Base from '../../layouts/Base.astro';
import { getAllLaws, formatDate } from '../../lib/sanity.js';
import scope from '../../../pipeline/law_scope.json';

const laws = await getAllLaws();
const todayISO = new Date().toISOString().slice(0, 10);

const rows = laws.map(law => {
  const regime = scope.regimes.find(r => r.slug === law.slug);
  const next = (regime?.steps || []).filter(s => s.date > todayISO)[0] || null;
  return { law, next };
}).sort((a, b) => {
  if(a.next && b.next) return a.next.date.localeCompare(b.next.date);
  if(a.next) return -1;
  if(b.next) return 1;
  return (a.law.order || 99) - (b.law.order || 99);
});

const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { month:'long', year:'numeric' });
---
<Base
  title="HREDD Law Timelines: CSDDD, EUDR, UFLPA and More | hredd.org"
  description="Verified timelines for every major supply chain due diligence law: the CSDDD, EUDR, UFLPA, LkSG and fourteen more, with the next statutory date for each."
  active="tracker"
>

<section class="law-head">
  <div class="wrap">
    <p class="kicker reveal">Every date, verified monthly</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.4vw,76px)">The law<br>timelines</h1>
    <p class="standfirst reveal" data-delay="2">One verified timeline for each of the eighteen regimes on this tracker, from first proposal to the dates still ahead, ordered here by whichever statutory step arrives next. Amendments and delays are logged openly, because in this field the calendar moves more than the law.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="law-rows reveal">
      {rows.map(({ law, next }) => (
        <a class="law-row" href={`/timeline/${law.slug}/`}>
          <div>
            <h3>{(law.shortName || law.name)} timeline</h3>
            <p class="sub">{next ? `Next statutory date: ${fmt(next.date)}, ${next.label.toLowerCase()}.` : `No fixed statutory dates ahead. Verified ${formatDate(law.lastUpdated)}.`}</p>
          </div>
          <span class="jur">{law.jurisdiction}</span>
          <span class="chip" data-g={law.statusType}>{law.status}</span>
        </a>
      ))}
    </div>
  </div>
</section>

</Base>
