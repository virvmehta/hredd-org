---
import Base from '../../layouts/Base.astro';
import { getAllLaws } from '../../lib/sanity.js';
import { buildBuyers, clientLaws } from '../../lib/redesignData.js';

const laws = await getAllLaws();
const buyers = buildBuyers(laws);
const lawsForClient = clientLaws(laws);
---
<Base
  title="Check your buyers | hredd.org"
  description="Suppliers: choose your buyer countries to see which HREDD laws apply to your trade relationships and what each one will ask of you."
  active="buyer-mapping"
>

<section class="section" style="padding-bottom:clamp(36px,4vw,56px)">
  <div class="wrap">
    <p class="kicker reveal">Check your buyers</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.6vw,80px)">Which laws reach<br /><em>your buyers?</em></h1>
    <p class="standfirst reveal" data-delay="2" style="margin-top:26px">Choose the countries where your buyers are based.
      We list every law that applies to those relationships and what each one will ask of you.</p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <p class="kicker reveal" style="margin-bottom:22px">Your buyers</p>
    <div class="buyer-chips reveal" data-delay="1" id="chips">
      {buyers.map((b) => (
        <button class="bchip" data-id={b.id}>{b.label}</button>
      ))}
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(30px,4vw,48px)">
  <div class="wrap">
    <div class="flow-panel reveal">
      <div class="flowmap" id="flowmap" hidden>
        <svg class="fm-links" id="fm-links" aria-hidden="true"></svg>
        <div class="fm-col">
          <p class="fm-head mono">You</p>
          <div class="fm-mid"><span class="fm-you" id="fm-you">Your business</span></div>
        </div>
        <div class="fm-col">
          <p class="fm-head mono">Your buyers</p>
          <div class="fm-mid" id="fm-buyers"></div>
        </div>
        <div class="fm-col">
          <p class="fm-head mono">The laws that apply</p>
          <div class="fm-mid" id="fm-laws"></div>
        </div>
      </div>
      <div class="net-empty" id="net-empty">Choose your buyer countries above and the laws that apply will appear here.</div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="kicker">The obligations</p>
        <h2 class="h2" id="result-title">All tracked laws</h2>
      </div>
      <span class="mono faint" id="result-count"></span>
    </div>
    <div class="law-grid" id="grid">
      {laws.map((l) => (
        <article class="law-card" data-g={l.statusType} data-slug={l.slug}>
          <div class="law-top"><span class="jur">{l.jurisdiction}</span>
            <span class="chip" data-g={l.statusType}>{l.status}</span></div>
          <h3><a href={`/laws/${l.slug}/`}>{l.name}</a></h3>
          <p>{l.tableUpdateText}</p>
          <a class="textlink" href={`/laws/${l.slug}/`}>Read <i>→</i></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ---- the flow map ----
     Replaces the earlier force-directed graph. Positions here are
     deterministic, labels are real HTML at legible sizes, law nodes are
     links, and the columns stack on narrow screens. Status colour on each
     dot is never the only encoding: the status word sits beside it.

     is:global is required, not optional: the buyer and law nodes are created
     at runtime by the script below, so Astro's scoped-style attributes never
     reach them and scoped rules would silently not apply. */
  .flow-panel{ border:1px solid var(--line); position:relative; min-height:220px;
    background:radial-gradient(100% 100% at 50% 50%, var(--panel-2), var(--bg) 75%); }
  .flowmap{ position:relative; display:grid; grid-template-columns:1fr 1.1fr 1.7fr;
    gap:clamp(24px,5vw,90px); padding:clamp(24px,4vw,44px); }
  .flowmap[hidden]{ display:none; }
  .fm-links{ position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .fm-col{ display:flex; flex-direction:column; position:relative; z-index:1; min-width:0; }
  .fm-head{ color:var(--ink-faint); margin:0 0 20px; font-size:10.5px; letter-spacing:.16em; }
  .fm-mid{ flex:1; display:flex; flex-direction:column; justify-content:center;
    gap:12px; align-items:flex-start; }
  .fm-you{ display:inline-flex; align-items:center; gap:12px; font-family:var(--mono);
    font-weight:500; font-size:11.5px; letter-spacing:.12em; text-transform:uppercase;
    color:var(--gold-hi); border:1px solid var(--gold); background:var(--gold-ghost);
    padding:14px 20px; }
  .fm-you::before{ content:""; width:8px; height:8px; flex:0 0 8px;
    background:var(--gold); transform:rotate(45deg); }
  .fm-buyer{ font-family:var(--mono); font-weight:500; font-size:11px; letter-spacing:.12em;
    text-transform:uppercase; color:var(--ink); border:1px solid var(--line);
    background:var(--bg-raise); padding:11px 16px; }
  .fm-law{ display:grid; grid-template-columns:10px minmax(0,1fr) auto; align-items:center;
    gap:12px; padding:8px 12px; border:1px solid transparent; width:100%;
    background:var(--bg-raise); transition:border-color .25s, background .25s; }
  .fm-law:hover{ border-color:var(--gold-dim); background:var(--gold-ghost); }
  .fm-law i{ width:9px; height:9px; border-radius:50%; }
  .fm-law b{ font:400 15.5px/1.3 var(--serif); color:var(--ink);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .fm-law span{ font-family:var(--mono); font-weight:500; font-size:10.5px;
    letter-spacing:.12em; text-transform:uppercase; color:var(--ink-dim); }
  .net-empty{ position:absolute; inset:0; display:grid; place-items:center; text-align:center;
    color:var(--ink-faint); font-style:italic; font-size:18px; padding:40px; }
  @media (max-width:720px){
    .flowmap{ grid-template-columns:1fr; gap:28px; }
    .fm-links{ display:none; }
    .fm-mid{ align-items:stretch; }
  }
</style>

<script type="application/json" id="bm-data" set:html={JSON.stringify({ buyers, laws: lawsForClient })}></script>
<script>
  const dataEl = document.getElementById('bm-data');
  const DATA = dataEl ? JSON.parse(dataEl.textContent || '{}') : { buyers: [], laws: [] };
  const bySlug = Object.fromEntries(DATA.laws.map((l) => [l.slug, l]));
  const chips = document.getElementById('chips');
  const grid = document.getElementById('grid');
  const selected = new Set();

  const flowmap = document.getElementById('flowmap');
  const linksSvg = document.getElementById('fm-links');
  const youEl = document.getElementById('fm-you');
  const buyersCol = document.getElementById('fm-buyers');
  const lawsCol = document.getElementById('fm-laws');
  const empty = document.getElementById('net-empty');
  const NS = 'http://www.w3.org/2000/svg';
  const STATUS_COLOR = { force: '#93b07d', pending: '#c9a35f', proposed: '#93a4bd', delayed: '#c07b68' };
  const STATUS_ORDER = { force: 0, pending: 1, proposed: 2, delayed: 3 };

  chips?.addEventListener('click', (e) => {
    const b = e.target instanceof Element && e.target.closest('.bchip');
    if (!b) return;
    b.classList.toggle('on');
    const id = b.getAttribute('data-id');
    selected.has(id) ? selected.delete(id) : selected.add(id);
    update();
  });

  function activeSlugs() {
    const slugs = new Set();
    selected.forEach((id) => {
      const buyer = DATA.buyers.find((b) => b.id === id);
      (buyer?.laws || []).forEach((s) => slugs.add(s));
    });
    return slugs;
  }

  function update() {
    const slugs = selected.size ? activeSlugs() : null;
    const title = document.getElementById('result-title');
    const count = document.getElementById('result-count');
    let shown = 0;
    Array.from(grid?.children || []).forEach((c) => {
      const ok = !slugs || slugs.has(c.getAttribute('data-slug'));
      c.classList.toggle('hide', !ok);
      if (ok) shown++;
    });
    if (title) title.innerHTML = slugs ? 'Laws reaching your buyers' : 'All tracked laws';
    if (count) count.textContent = shown + ' of ' + DATA.laws.length + ' laws';
    renderFlow(slugs);
  }

  /* ---- deterministic three-column flow map ---- */
  const pairs = []; // [buyerEl, lawEl] connector endpoints, rebuilt on render

  function renderFlow(slugs) {
    if (!slugs) {
      flowmap.hidden = true;
      empty.style.display = 'grid';
      return;
    }
    flowmap.hidden = false;
    empty.style.display = 'none';

    buyersCol.innerHTML = '';
    lawsCol.innerHTML = '';
    pairs.length = 0;

    const buyerEls = {};
    selected.forEach((id) => {
      const b = DATA.buyers.find((x) => x.id === id);
      if (!b) return;
      const el = document.createElement('span');
      el.className = 'fm-buyer';
      el.textContent = b.label.replace(' (any member)', '');
      buyersCol.appendChild(el);
      buyerEls[id] = el;
    });

    const lawSlugs = [...slugs].sort((a, b) => {
      const la = bySlug[a], lb = bySlug[b];
      return (STATUS_ORDER[la?.group] ?? 9) - (STATUS_ORDER[lb?.group] ?? 9) ||
        String(la?.short).localeCompare(String(lb?.short));
    });
    const lawEls = {};
    lawSlugs.forEach((slug) => {
      const l = bySlug[slug];
      if (!l) return;
      const a = document.createElement('a');
      a.className = 'fm-law';
      a.href = '/laws/' + slug + '/';
      const dot = document.createElement('i');
      dot.style.background = STATUS_COLOR[l.group] || 'var(--ink-faint)';
      const name = document.createElement('b');
      name.textContent = l.short;
      const st = document.createElement('span');
      st.textContent = l.status;
      a.append(dot, name, st);
      lawsCol.appendChild(a);
      lawEls[slug] = a;
    });

    selected.forEach((id) => {
      const b = DATA.buyers.find((x) => x.id === id);
      (b?.laws || []).forEach((slug) => {
        if (buyerEls[id] && lawEls[slug]) pairs.push([buyerEls[id], lawEls[slug]]);
      });
    });

    requestAnimationFrame(drawLinks);
  }

  function drawLinks() {
    if (flowmap.hidden) return;
    const box = flowmap.getBoundingClientRect();
    linksSvg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    while (linksSvg.firstChild) linksSvg.removeChild(linksSvg.firstChild);

    const edge = (el, side) => {
      const r = el.getBoundingClientRect();
      return { x: (side === 'r' ? r.right : r.left) - box.left, y: r.top + r.height / 2 - box.top };
    };
    const curve = (a, b, stroke, w) => {
      const dx = Math.max(30, (b.x - a.x) * 0.5);
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', `M${a.x},${a.y} C${a.x + dx},${a.y} ${b.x - dx},${b.y} ${b.x},${b.y}`);
      p.setAttribute('fill', 'none');
      p.setAttribute('stroke', stroke);
      p.setAttribute('stroke-width', w);
      linksSvg.appendChild(p);
    };

    const you = edge(youEl, 'r');
    Array.from(buyersCol.children).forEach((bEl) => {
      curve(you, edge(bEl, 'l'), 'rgba(201,163,95,.5)', '1.5');
    });
    pairs.forEach(([bEl, lEl]) => {
      curve(edge(bEl, 'r'), edge(lEl, 'l'), 'rgba(201,163,95,.28)', '1.2');
    });
  }

  addEventListener('resize', drawLinks, { passive: true });
  update();
</script>

</Base>
