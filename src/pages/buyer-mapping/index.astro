---
import Base from '../../layouts/Base.astro';
import { getAllLaws } from '../../lib/sanity.js';

const laws = await getAllLaws();

/**
 * Buyer jurisdictions shown as pills. Selecting a buyer country shows
 * every national law of that country plus every EU-level law where the
 * country is an EU member state, because EU buyers carry both layers.
 */
const EU_MEMBER_A3 = new Set([
  'AUT', 'BEL', 'BGR', 'HRV', 'CYP', 'CZE', 'DNK', 'EST', 'FIN', 'FRA',
  'DEU', 'GRC', 'HUN', 'IRL', 'ITA', 'LVA', 'LTU', 'LUX', 'MLT', 'NLD',
  'POL', 'PRT', 'ROU', 'SVK', 'SVN', 'ESP', 'SWE'
]);

const buyers = [
  { code: 'EU', label: 'European Union (any member)' },
  { code: 'DEU', label: 'Germany' },
  { code: 'FRA', label: 'France' },
  { code: 'NLD', label: 'Netherlands' },
  { code: 'NOR', label: 'Norway' },
  { code: 'CHE', label: 'Switzerland' },
  { code: 'GBR', label: 'United Kingdom' },
  { code: 'USA', label: 'United States' },
  { code: 'CAN', label: 'Canada' },
  { code: 'AUS', label: 'Australia' },
  { code: 'JPN', label: 'Japan' },
  { code: 'KOR', label: 'South Korea' }
];

const isEuLaw = (law) => law.region === 'European Union';

function lawsForBuyer(code) {
  if (code === 'EU') return laws.filter(isEuLaw);
  return laws.filter((law) => {
    const codes = law.countryCodes || (law.countryCode ? [law.countryCode] : []);
    if (isEuLaw(law)) return EU_MEMBER_A3.has(code);
    return codes.includes(code);
  });
}

const buyerIndex = Object.fromEntries(
  buyers.map((b) => [b.code, lawsForBuyer(b.code).map((l) => l.slug)])
);
---
<Base
  title="Buyer compliance mapping | hredd.org"
  description="Suppliers: select your buyer countries to see which HREDD laws apply to your trade relationships."
  activePage="buyer-mapping"
>
  <section class="page-title-block page-pad">
    <h1>Buyer compliance mapping</h1>
    <p class="subtitle">
      Suppliers: select your buyer countries to see which HREDD laws apply to
      your trade relationships.
    </p>
  </section>

  <div class="page-pad rule-primary">
    <div class="buyer-pills" role="group" aria-label="Select buyer countries">
      {buyers.map((b) => (
        <button data-buyer={b.code} aria-pressed="false">{b.label}</button>
      ))}
    </div>
  </div>

  <section class="buyer-results page-pad">
    <p class="result-count" id="result-count">
      Select one or more buyer countries above to map the laws that reach your trade relationships.
    </p>
    <div id="buyer-law-cards">
      {laws.map((law) => (
        <a class="law-card" href={`/laws/${law.slug}/`} data-slug={law.slug} style="display: none;">
          <span class="lc-head">
            <span class="lc-name">{law.name}</span>
            <span class={`status-badge status-${law.statusType}`}>{law.status}</span>
          </span>
          <span class="lc-jur">{law.jurisdiction}</span>
          <p class="lc-summary">{law.oneLineSummary}</p>
          <span class="lc-more">Read more &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <script type="application/json" id="buyer-index-data" set:html={JSON.stringify(buyerIndex)} />

  <script>
    const dataEl = document.getElementById('buyer-index-data');
    const buyerIndex = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
    const pills = document.querySelectorAll('.buyer-pills button');
    const cards = document.querySelectorAll('#buyer-law-cards .law-card');
    const countEl = document.getElementById('result-count');
    const active = new Set();

    function refresh() {
      const slugs = new Set();
      active.forEach((code) => (buyerIndex[code] || []).forEach((s) => slugs.add(s)));
      let shown = 0;
      cards.forEach((card) => {
        const visible = slugs.has(card.getAttribute('data-slug'));
        card.style.display = visible ? '' : 'none';
        if (visible) shown += 1;
      });
      if (active.size === 0) {
        countEl.textContent =
          'Select one or more buyer countries above to map the laws that reach your trade relationships.';
      } else {
        const lawWord = shown === 1 ? 'law applies' : 'laws apply';
        countEl.textContent = `${shown} ${lawWord} to your selected buyer countries.`;
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const code = pill.getAttribute('data-buyer');
        if (active.has(code)) {
          active.delete(code);
          pill.classList.remove('active');
          pill.setAttribute('aria-pressed', 'false');
        } else {
          active.add(code);
          pill.classList.add('active');
          pill.setAttribute('aria-pressed', 'true');
        }
        refresh();
      });
    });
  </script>
</Base>
