---
import Base from '../../layouts/Base.astro';
import { getAllLaws } from '../../lib/sanity.js';
import { buildBuyers, clientLaws } from '../../lib/redesignData.js';

const laws = await getAllLaws();
const buyers = buildBuyers(laws);
const lawsForClient = clientLaws(laws);
---
<Base
  title="Buyer compliance mapping | hredd.org"
  description="Suppliers: select your buyer countries to see which HREDD laws apply to your trade relationships."
  active="buyer-mapping"
>

<section class="section" style="padding-bottom:clamp(36px,4vw,56px)">
  <div class="wrap">
    <p class="kicker reveal">Buyer compliance mapping</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.6vw,80px)">Which laws reach<br /><em>your</em> order book?</h1>
    <p class="standfirst reveal" data-delay="2" style="margin-top:26px">Select your buyer countries.
      We map every HREDD regime that applies to those trade relationships, and what each one will ask of you.</p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <p class="kicker reveal" style="margin-bottom:22px">Your buyers</p>
    <div class="buyer-chips reveal" data-delay="1" id="chips">
      {buyers.map((b) => (
        <button class="bchip" data-id={b.id}>{b.label}</button>
      ))}
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(30px,4vw,48px)">
  <div class="wrap">
    <div class="net-panel reveal">
      <svg id="network" viewBox="0 0 1200 620" role="img" aria-label="Network diagram linking your factory to buyer countries and the laws that apply"></svg>
      <div class="net-empty" id="net-empty">Select one or more buyer countries above<br />to map the laws that reach your trade relationships.</div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="kicker">The obligations</p>
        <h2 class="h2" id="result-title">All tracked laws</h2>
      </div>
      <span class="mono faint" id="result-count"></span>
    </div>
    <div class="law-grid" id="grid">
      {laws.map((l) => (
        <article class="law-card" data-g={l.statusType} data-slug={l.slug}>
          <div class="law-top"><span class="jur">{l.jurisdiction}</span>
            <span class="chip" data-g={l.statusType}>{l.status}</span></div>
          <h3><a href={`/laws/${l.slug}/`}>{l.name}</a></h3>
          <p>{l.tableUpdateText}</p>
          <a class="textlink" href={`/laws/${l.slug}/`}>Read <i>→</i></a>
        </article>
      ))}
    </div>
  </div>
</section>

<script type="application/json" id="bm-data" set:html={JSON.stringify({ buyers, laws: lawsForClient })}></script>
<script>
  const dataEl = document.getElementById('bm-data');
  const DATA = dataEl ? JSON.parse(dataEl.textContent || '{}') : { buyers: [], laws: [] };
  const bySlug = Object.fromEntries(DATA.laws.map((l) => [l.slug, l]));
  const chips = document.getElementById('chips');
  const grid = document.getElementById('grid');
  const svg = document.getElementById('network');
  const empty = document.getElementById('net-empty');
  const selected = new Set();
  const NS = 'http://www.w3.org/2000/svg';
  const W = 1200, H = 620;
  const COLOR = { force: '#93b07d', pending: '#c9a35f', proposed: '#93a4bd', delayed: '#c07b68' };
  let nodes = [], links = [], raf = null, dragging = null;

  chips?.addEventListener('click', (e) => {
    const b = e.target instanceof Element && e.target.closest('.bchip');
    if (!b) return;
    b.classList.toggle('on');
    const id = b.getAttribute('data-id');
    selected.has(id) ? selected.delete(id) : selected.add(id);
    update();
  });

  function activeSlugs() {
    const slugs = new Set();
    selected.forEach((id) => {
      const buyer = DATA.buyers.find((b) => b.id === id);
      (buyer?.laws || []).forEach((s) => slugs.add(s));
    });
    return slugs;
  }

  function update() {
    const slugs = selected.size ? activeSlugs() : null;
    const title = document.getElementById('result-title');
    const count = document.getElementById('result-count');
    let shown = 0;
    Array.from(grid?.children || []).forEach((c) => {
      const ok = !slugs || slugs.has(c.getAttribute('data-slug'));
      c.classList.toggle('hide', !ok);
      if (ok) {
        c.classList.add('pop');
        setTimeout(() => c.classList.remove('pop'), 40 + shown * 40);
        shown++;
      }
    });
    if (title) title.innerHTML = slugs ? 'Laws reaching <em>your</em> buyers' : 'All tracked laws';
    if (count) count.textContent = shown + ' of ' + DATA.laws.length + ' laws';
    drawNetwork(slugs);
  }

  function drawNetwork(slugs) {
    if (raf) cancelAnimationFrame(raf);
    while (svg?.firstChild) svg.removeChild(svg.firstChild);
    if (!slugs) { if (empty) empty.style.display = 'grid'; return; }
    if (empty) empty.style.display = 'none';

    nodes = [{ id: 'you', type: 'you', label: 'Your factory', x: W / 2, y: H / 2, vx: 0, vy: 0 }];
    links = [];
    selected.forEach((id) => {
      const b = DATA.buyers.find((x) => x.id === id);
      if (!b) return;
      nodes.push({ id: 'b:' + id, type: 'buyer', label: b.label.replace(' (any member)', ''),
        x: W / 2 + (Math.random() - 0.5) * 300, y: H / 2 + (Math.random() - 0.5) * 300, vx: 0, vy: 0 });
      links.push(['you', 'b:' + id, 170]);
      b.laws.forEach((slug) => {
        if (!nodes.some((n) => n.id === 'l:' + slug)) {
          const l = bySlug[slug];
          nodes.push({ id: 'l:' + slug, type: 'law', label: l?.short || slug, group: l?.group,
            slug, x: W / 2 + (Math.random() - 0.5) * 500, y: H / 2 + (Math.random() - 0.5) * 400, vx: 0, vy: 0 });
        }
        links.push(['b:' + id, 'l:' + slug, 110]);
      });
    });
    const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

    const lineEls = links.map(() => {
      const el = document.createElementNS(NS, 'line');
      el.setAttribute('stroke', 'rgba(201,163,95,.25)');
      svg.appendChild(el);
      return el;
    });
    const groupEls = nodes.map((n) => {
      const g = document.createElementNS(NS, 'g');
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('r', n.type === 'you' ? '34' : n.type === 'buyer' ? '22' : '8');
      c.setAttribute('fill', n.type === 'you' ? '#c9a35f' : n.type === 'buyer' ? 'rgba(201,163,95,.15)' : COLOR[n.group] || '#b1a892');
      c.setAttribute('stroke', n.type === 'law' ? 'rgba(14,13,10,.9)' : '#c9a35f');
      const t = document.createElementNS(NS, 'text');
      t.textContent = n.label;
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('dy', n.type === 'law' ? '24' : '4');
      t.setAttribute('font-family', 'Space Grotesk, Helvetica Neue, Arial, sans-serif');
      t.setAttribute('font-size', n.type === 'law' ? '11' : '10');
      t.setAttribute('letter-spacing', '1');
      t.setAttribute('fill', n.type === 'you' ? '#14120d' : n.type === 'buyer' ? '#e2c286' : '#b1a892');
      t.style.textTransform = 'uppercase';
      t.style.pointerEvents = 'none';
      g.appendChild(c); g.appendChild(t);
      g.style.cursor = n.type === 'law' ? 'pointer' : 'grab';
      g.addEventListener('click', () => { if (n.type === 'law' && !n.moved) location.href = '/laws/' + n.slug + '/'; });
      g.addEventListener('pointerdown', (ev) => {
        dragging = n; n.moved = false;
        g.setPointerCapture(ev.pointerId);
        ev.preventDefault();
      });
      svg.appendChild(g);
      return g;
    });

    svg.addEventListener('pointermove', onDrag);
    svg.addEventListener('pointerup', () => { dragging = null; });

    function onDrag(ev) {
      if (!dragging) return;
      const r = svg.getBoundingClientRect();
      dragging.x = ((ev.clientX - r.left) / r.width) * W;
      dragging.y = ((ev.clientY - r.top) / r.height) * H;
      dragging.vx = 0; dragging.vy = 0;
      dragging.moved = true;
    }

    // lightweight force simulation: repulsion + springs + centring
    let alpha = 1;
    function tick() {
      alpha += (0.06 - alpha) * 0.02;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          let dx = b.x - a.x, dy = b.y - a.y;
          let d2 = dx * dx + dy * dy || 1;
          const d = Math.sqrt(d2);
          const f = Math.min(2600 / d2, 6) * alpha;
          dx /= d; dy /= d;
          a.vx -= dx * f; a.vy -= dy * f;
          b.vx += dx * f; b.vy += dy * f;
        }
      }
      for (const [s, t, len] of links) {
        const a = byId[s], b = byId[t];
        let dx = b.x - a.x, dy = b.y - a.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        const f = (d - len) * 0.02 * alpha * 8;
        dx /= d; dy /= d;
        a.vx += dx * f; a.vy += dy * f;
        b.vx -= dx * f; b.vy -= dy * f;
      }
      for (const n of nodes) {
        if (n === dragging) continue;
        n.vx += (W / 2 - n.x) * 0.0012;
        n.vy += (H / 2 - n.y) * 0.0012;
        n.vx *= 0.86; n.vy *= 0.86;
        n.x = Math.max(70, Math.min(W - 70, n.x + n.vx));
        n.y = Math.max(50, Math.min(H - 50, n.y + n.vy));
      }
      links.forEach(([s, t], i) => {
        const a = byId[s], b = byId[t], el = lineEls[i];
        el.setAttribute('x1', a.x); el.setAttribute('y1', a.y);
        el.setAttribute('x2', b.x); el.setAttribute('y2', b.y);
      });
      nodes.forEach((n, i) => groupEls[i].setAttribute('transform', 'translate(' + n.x + ',' + n.y + ')'));
      raf = requestAnimationFrame(tick);
    }
    tick();
  }

  update();
</script>

</Base>
