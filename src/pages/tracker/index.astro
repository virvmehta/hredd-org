---
import Base from '../../layouts/Base.astro';
import { getAllLaws } from '../../lib/sanity.js';
import { buildWorldMap, buildCountryLawIndex } from '../../lib/mapData.js';
import { buildMovements } from '../../lib/redesignData.js';

const laws = await getAllLaws();
const map = buildWorldMap(laws);
const countryIndex = buildCountryLawIndex(laws);
const movements = buildMovements(laws, 8);
const latestMonth = movements[0]?.date || '';

const counts = {
  all: laws.length,
  force: laws.filter((l) => l.statusType === 'force').length,
  pending: laws.filter((l) => l.statusType === 'pending').length,
  proposed: laws.filter((l) => l.statusType === 'proposed').length,
  delayed: laws.filter((l) => l.statusType === 'delayed').length
};
---
<Base
  title="The tracker | hredd.org"
  description="A modular tracker of mandatory human rights and environmental due diligence laws worldwide, maintained monthly from a Global South perspective."
  active="tracker"
>

<section class="section" style="padding-bottom:clamp(40px,5vw,64px)">
  <div class="wrap">
    <p class="kicker reveal">The tracker</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.6vw,80px)">Every regime that reaches<br /><em>your</em> supply chain</h1>
    <p class="standfirst reveal" data-delay="2" style="margin-top:26px">Every mandatory HREDD regime that reaches
      Global South supply chains, tracked monthly with a changelog on every entry.</p>
    <div class="stats reveal" data-delay="3" style="margin-top:48px">
      <div class="stat"><b data-count={counts.all}>{counts.all}</b><span>Laws tracked</span></div>
      <div class="stat"><b data-count={counts.force}>{counts.force}</b><span>In force</span></div>
      <div class="stat"><b data-count={counts.pending}>{counts.pending}</b><span>Pending</span></div>
      <div class="stat"><b data-count={counts.proposed}>{counts.proposed}</b><span>Proposed</span></div>
      <div class="stat"><b data-count={counts.delayed}>{counts.delayed}</b><span>Delayed</span></div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">The atlas</p>
        <h2 class="h2">Where the rules are written</h2>
      </div>
      <span class="mono faint">Hover a gold jurisdiction · click to filter the ledger</span>
    </div>
    <div class="map-panel reveal" data-delay="1">
      <svg id="worldmap" viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-label="World map of jurisdictions with tracked HREDD laws">
        {map.paths.map((p) => (
          <path
            class="cty"
            d={p.d}
            data-code={p.code || undefined}
            data-name={p.name}
            fill={p.hasLaws ? 'rgba(201,163,95,.55)' : 'rgba(234,228,213,.10)'}
            stroke="rgba(14,13,10,.9)"
            stroke-width="0.6"
          ></path>
        ))}
      </svg>
      <div class="map-legend">
        <span><i style="background:rgba(201,163,95,.55)"></i>Tracked laws apply</span>
        <span><i style="background:rgba(234,228,213,.10)"></i>No tracked laws</span>
        <button class="gold mono" id="map-clear" style="cursor:pointer; display:none; background:none; border:0; padding:0">✕ Clear selection</button>
      </div>
    </div>
  </div>
</section>
<div class="tooltip" id="map-tip"></div>

<section class="section" id="movements" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">Changelog</p>
        <h2 class="h2">This month's <em>movements</em></h2>
      </div>
      <span class="mono faint">Updated {latestMonth}</span>
    </div>
    <div class="timeline">
      {movements.map((m, i) => (
        <div class="tl-item reveal" data-delay={Math.min(i, 3)}>
          <span class="date">{m.date}</span>
          <h3><a href={`/laws/${m.slug}/`}>{m.tag}</a></h3>
          <p>{m.latest}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section" id="ledger" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">The ledger</p>
        <h2 class="h2">All tracked laws</h2>
      </div>
      <div class="tabs" id="tabs">
        <button class="tab on" data-f="all">All ({counts.all})</button>
        <button class="tab" data-f="force">In force ({counts.force})</button>
        <button class="tab" data-f="pending">Pending ({counts.pending})</button>
        <button class="tab" data-f="proposed">Proposed ({counts.proposed})</button>
        <button class="tab" data-f="delayed">Delayed ({counts.delayed})</button>
      </div>
    </div>
    <div class="law-grid reveal" data-delay="1" id="grid">
      {laws.map((l) => (
        <article class="law-card" data-g={l.statusType} data-slug={l.slug}>
          <div class="law-top"><span class="jur">{l.jurisdiction}</span>
            <span class="chip" data-g={l.statusType}>{l.status}</span></div>
          <h3><a href={`/laws/${l.slug}/`}>{l.name}</a></h3>
          <p>{l.tableUpdateText}</p>
          <a class="textlink" href={`/laws/${l.slug}/`}>Read <i>→</i></a>
        </article>
      ))}
    </div>
  </div>
</section>

<script type="application/json" id="country-index" set:html={JSON.stringify(countryIndex)}></script>
<script>
  const idxEl = document.getElementById('country-index');
  const index = idxEl ? JSON.parse(idxEl.textContent || '{}') : { laws: [], byCountry: {} };
  const grid = document.getElementById('grid');
  const tabs = document.getElementById('tabs');
  const clearBtn = document.getElementById('map-clear');
  const tip = document.getElementById('map-tip');
  const svg = document.getElementById('worldmap');
  const state = { filter: 'all', slugs: null };

  function apply() {
    if (!grid) return;
    const cards = Array.from(grid.children);
    let shown = 0;
    cards.forEach((c) => {
      const ok = state.slugs
        ? state.slugs.has(c.getAttribute('data-slug'))
        : state.filter === 'all' || c.getAttribute('data-g') === state.filter;
      c.classList.toggle('hide', !ok);
      if (ok) {
        c.classList.add('pop');
        setTimeout(() => c.classList.remove('pop'), 40 + shown * 45);
        shown++;
      }
    });
  }

  function clearPick() {
    svg?.querySelectorAll('path[data-code]').forEach((p) => {
      p.setAttribute('fill', 'rgba(201,163,95,.55)');
      p.removeAttribute('data-picked');
    });
    if (clearBtn) clearBtn.style.display = 'none';
  }

  tabs?.addEventListener('click', (e) => {
    const b = e.target instanceof Element && e.target.closest('.tab');
    if (!b) return;
    tabs.querySelectorAll('.tab').forEach((t) => t.classList.remove('on'));
    b.classList.add('on');
    state.filter = b.getAttribute('data-f') || 'all';
    state.slugs = null;
    clearPick();
    apply();
  });

  svg?.addEventListener('mousemove', (e) => {
    const p = e.target instanceof Element && e.target.closest('path[data-code]');
    if (!p || !tip) { tip?.classList.remove('show'); return; }
    const code = p.getAttribute('data-code');
    const ids = index.byCountry[code] || [];
    p.setAttribute('fill', 'rgba(226,194,134,.8)');
    tip.innerHTML =
      '<div class="t-jur">' + (p.getAttribute('data-name') || '') + '</div><ul>' +
      ids.map((i) => {
        const l = index.laws[i];
        return '<li>' + l.name + ' <span>· ' + l.status + '</span></li>';
      }).join('') + '</ul>';
    tip.classList.add('show');
    tip.style.left = Math.min(e.clientX + 18, innerWidth - 320) + 'px';
    tip.style.top = e.clientY + 18 + 'px';
  });

  svg?.addEventListener('mouseout', (e) => {
    const p = e.target instanceof Element && e.target.closest('path[data-code]');
    if (!p) return;
    tip?.classList.remove('show');
    if (!p.hasAttribute('data-picked')) p.setAttribute('fill', 'rgba(201,163,95,.55)');
  });

  svg?.addEventListener('click', (e) => {
    const p = e.target instanceof Element && e.target.closest('path[data-code]');
    if (!p) return;
    const code = p.getAttribute('data-code');
    const ids = index.byCountry[code] || [];
    clearPick();
    p.setAttribute('fill', 'rgba(226,194,134,.9)');
    p.setAttribute('data-picked', 'true');
    state.slugs = new Set(ids.map((i) => index.laws[i].slug));
    tabs?.querySelectorAll('.tab').forEach((t) => t.classList.remove('on'));
    if (clearBtn) clearBtn.style.display = 'inline';
    apply();
    const ledger = document.getElementById('ledger');
    if (ledger) scrollTo({ top: ledger.offsetTop - 80, behavior: 'smooth' });
  });

  clearBtn?.addEventListener('click', () => {
    state.slugs = null;
    state.filter = 'all';
    clearPick();
    tabs?.querySelector('[data-f="all"]')?.classList.add('on');
    apply();
  });
</script>

</Base>
