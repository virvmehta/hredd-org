---
import Base from '../../layouts/Base.astro';
import { getAllLaws, formatMonthYear } from '../../lib/sanity.js';
import { buildWorldMap, buildCountryLawIndex } from '../../lib/mapData.js';

const laws = await getAllLaws();
const map = buildWorldMap(laws);
const countryIndex = buildCountryLawIndex(laws);

const inForce = laws.filter((l) => l.statusType === 'force').length;
const pending = laws.filter((l) => l.statusType === 'pending').length;
const proposed = laws.filter((l) => l.statusType === 'proposed').length;
const delayed = laws.filter((l) => l.statusType === 'delayed').length;

const mostRecent = laws.reduce((latest, l) => {
  const d = new Date(l.lastUpdated || 0);
  return d > latest ? d : latest;
}, new Date(0));
const nextUpdate = new Date(mostRecent.getFullYear(), mostRecent.getMonth() + 1, 1);

const movements = [...laws]
  .sort((a, b) => new Date(b.lastUpdated || 0) - new Date(a.lastUpdated || 0))
  .slice(0, 6);

const tabs = [
  { key: 'all', label: `All (${laws.length})` },
  { key: 'force', label: `In force (${inForce})` },
  { key: 'pending', label: `Pending (${pending})` },
  { key: 'proposed', label: `Proposed (${proposed})` },
  { key: 'delayed', label: `Delayed (${delayed})` }
];
---
<Base
  title="The tracker | hredd.org"
  description="A modular tracker of mandatory human rights and environmental due diligence laws worldwide, maintained monthly from a Global South perspective."
  activePage="tracker"
>
  <section class="page-title-block page-pad">
    <h1>The tracker</h1>
    <p class="subtitle">
      Every mandatory HREDD regime that reaches Global South supply chains,
      tracked monthly with a changelog on every entry.
    </p>
  </section>

  <div class="page-pad">
    <div class="tracker-stats">
      <div class="t-stat"><div class="num">{laws.length}</div><div class="lab">Laws tracked</div></div>
      <div class="t-stat"><div class="num">{inForce}</div><div class="lab">In force</div></div>
      <div class="t-stat"><div class="num">{pending}</div><div class="lab">Pending</div></div>
      <div class="t-stat"><div class="num">{proposed}</div><div class="lab">Proposed</div></div>
      <div class="t-stat"><div class="num">{delayed}</div><div class="lab">Delayed</div></div>
    </div>
  </div>

  <a class="update-banner" href="#movements">
    Updated {formatMonthYear(mostRecent.toISOString())} &middot; Next update {formatMonthYear(nextUpdate.toISOString())}
  </a>

  <section class="world-map-wrap page-pad" aria-label="World map of tracked laws">
    <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-label="Map of countries with tracked HREDD laws" id="tracker-map">
      {map.paths.map((p) => (
        <path
          d={p.d}
          class={`map-country${p.hasLaws ? ' has-laws' : ''}`}
          data-code={p.code}
          data-name={p.name}
          tabindex={p.hasLaws ? '0' : undefined}
          role={p.hasLaws ? 'button' : undefined}
          aria-label={p.hasLaws ? `Show laws for ${p.name}` : undefined}
        />
      ))}
    </svg>
    <div class="map-caption">
      <span class="key"><span class="swatch" style="background: var(--map-dark);"></span> Tracked laws apply</span>
      <span class="key"><span class="swatch" style="background: var(--map-light);"></span> No tracked laws</span>
      <span>Click a dark country to see its laws</span>
    </div>
  </section>

  <section class="country-panel page-pad" id="country-panel" aria-live="polite">
    <h3 id="panel-country-name"></h3>
    <div id="panel-laws"></div>
  </section>

  <section class="movements page-pad" id="movements">
    <h2 class="rule-primary" style="padding-top: 28px;">This month&rsquo;s movements</h2>
    {movements.map((law) => (
      <div class="movement-item">
        <span class="m-date">{formatMonthYear(law.lastUpdated)}</span>
        <span class="m-text">
          <a href={`/laws/${law.slug}/`}>{law.shortName || law.name}</a>: {law.tableUpdateText}
        </span>
      </div>
    ))}
  </section>

  <section class="page-pad" style="padding-bottom: 64px;">
    <div class="section-head rule-primary" style="margin-top: 40px;">
      <h2>All tracked laws</h2>
    </div>
    <div class="filter-tabs" role="tablist" aria-label="Filter laws by status">
      {tabs.map((t, i) => (
        <button data-filter={t.key} class={i === 0 ? 'active' : ''} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>
      ))}
    </div>
    <div id="law-table">
      {laws.map((law) => (
        <div class="law-row" data-status={law.statusType}>
          <a class="law-name" href={`/laws/${law.slug}/`}>{law.name}</a>
          <span class="law-jur">{law.jurisdiction}</span>
          <span class={`status-badge status-${law.statusType}`}>{law.status}</span>
          <span class="law-update">{law.tableUpdateText}</span>
          <a class="law-link" href={`/laws/${law.slug}/`}>Read &rarr;</a>
        </div>
      ))}
    </div>
  </section>

  <script type="application/json" id="country-law-data" set:html={JSON.stringify(countryIndex)} />

  <script>
    const dataEl = document.getElementById('country-law-data');
    const indexData = dataEl ? JSON.parse(dataEl.textContent || '{}') : { laws: [], byCountry: {} };
    const panel = document.getElementById('country-panel');
    const panelName = document.getElementById('panel-country-name');
    const panelLaws = document.getElementById('panel-laws');
    let selected = null;

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[c]);
    }

    function openCountry(el) {
      const code = el.getAttribute('data-code');
      const name = el.getAttribute('data-name');
      const laws = (indexData.byCountry[code] || []).map((i) => indexData.laws[i]);
      if (!laws.length) return;

      if (selected) selected.classList.remove('selected');
      el.classList.add('selected');
      selected = el;

      panelName.textContent = name;
      panelLaws.innerHTML = laws
        .map(
          (l) => `
        <a class="panel-law" href="/laws/${escapeHtml(l.slug)}/">
          <span class="pl-head">
            <span class="pl-name">${escapeHtml(l.name)}</span>
            <span class="status-badge status-${escapeHtml(l.statusType)}">${escapeHtml(l.status)}</span>
          </span>
          <span class="pl-summary">${escapeHtml(l.summary)}</span>
          <span class="pl-more">Read more &rarr;</span>
        </a>`
        )
        .join('');
      panel.classList.add('open');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    document.querySelectorAll('.map-country.has-laws').forEach((el) => {
      el.addEventListener('click', () => openCountry(el));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openCountry(el);
        }
      });
    });

    const tabs = document.querySelectorAll('.filter-tabs button');
    const rows = document.querySelectorAll('#law-table .law-row');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const f = tab.getAttribute('data-filter');
        rows.forEach((r) => {
          r.style.display = f === 'all' || r.getAttribute('data-status') === f ? '' : 'none';
        });
      });
    });
  </script>
</Base>
