---
import { getAllLaws } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const laws = await getAllLaws();
  return laws.map((law) => ({ params: { slug: law.slug } }));
}

const { slug } = Astro.params;
const target = `/laws/${slug}/`;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<title>Redirecting</title>
<meta http-equiv="refresh" content={`0; url=${target}`} />
<link rel="canonical" href={target} />
</head>
<body>
<p>This entry has moved. <a href={target}>Continue to the law page</a>.</p>
</body>
</html>
