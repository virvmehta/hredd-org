---
import Base from '../../layouts/Base.astro';
import { getSiteSettings } from '../../lib/sanity.js';

const settings = await getSiteSettings();
const contactEmail = settings?.contactEmail || 'hello@hredd.org';
const disclosure = 'hredd.org is an independent publication with no affiliation with any organisation, public or private. The views contained herein are personal. hredd.org is not funded by any organisation.';

// Organization + founder Person: the "who stands behind this" signal that both
// Google E-E-A-T and AI answer engines look for before trusting a source on a
// legal topic. sameAs is intentionally omitted rather than faked; add real
// LinkedIn/X profile URLs there when available for a further authority lift.
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "hredd.org",
  "url": "https://hredd.org",
  "email": contactEmail,
  "foundingDate": "2026",
  "logo": { "@type": "ImageObject", "url": "https://hredd.org/favicon.png" },
  "description": "An independent tracker of human rights and environmental due diligence law, read from the supplier side of the chain.",
  "knowsAbout": ["Human rights due diligence", "Environmental due diligence", "CSDDD", "EUDR", "UFLPA", "Supply chain law", "Global South suppliers"],
  "founder": {
    "@type": "Person",
    "name": "Vir Mehta",
    "jobTitle": "Decent work and supply chain sustainability practitioner",
    "description": "Vir Mehta is a decent work and supply chain sustainability practitioner based in Noida, India.",
    "address": { "@type": "PostalAddress", "addressLocality": "Noida", "addressCountry": "IN" }
  }
};
---
<Base
  title="About hredd.org: independent HREDD law tracker from the Global South"
  description="hredd.org is an independent monthly tracker of human rights and environmental due diligence law, read from the supplier side of the chain. Published from Noida, India."
  active="about"
>

<script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />

<section class="section" style="padding-bottom:clamp(36px,4vw,56px)">
  <div class="wrap">
    <p class="kicker reveal">About</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(40px,5.6vw,80px)">Tracked from the side<br />that answers the <em>questionnaires</em></h1>
    <p class="standfirst reveal" data-delay="2" style="margin-top:26px">hredd.org is an independent monthly publication
      that tracks due diligence law from the supplier side. It has been published from Noida, India, since 2026,
      and it takes no funding from any organisation.</p>
  </div>
</section>

<section class="section" style="padding-top:0; padding-bottom:0">
  <div class="wrap" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:24px">
    <div class="panel reveal">
      <h4>Why we exist</h4>
      <p style="margin:0; color:var(--ink-dim)">HREDD law is written in Brussels, Washington and Canberra,
        but it lands on factory floors in the Global South. We read every regime from the receiving end:
        what it obliges, when it bites, and what a supplier will actually be asked to produce.</p>
    </div>
    <div class="panel reveal" data-delay="1">
      <h4>How we work</h4>
      <p style="margin:0; color:var(--ink-dim)">Every tracked law is reviewed monthly against primary sources,
        with a changelog on every entry. No paywalls and no consulting upsell: a public ledger of who must
        do what, and by when.</p>
    </div>
    <div class="panel reveal" data-delay="2" id="contact">
      <h4>Contact</h4>
      <p style="margin:0 0 18px; color:var(--ink-dim)">Corrections, tips and field reports are welcome.</p>
      <a class="btn" href={`mailto:${contactEmail}`}><span>Write to us</span></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="disclosure reveal">{disclosure}</div>
  </div>
</section>

</Base>
