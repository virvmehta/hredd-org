---
import Base from '../../layouts/Base.astro';
import { getAllArticles, getSiteSettings, renderBody, formatDate } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const settings = await getSiteSettings();
const bodyHtml = renderBody(article.body);
const disclosure = article.disclosureOverride || settings?.articleDisclaimer ||
  'hredd.org is an independent publication with no affiliation with any organisation, public or private. The views contained herein are personal. hredd.org is not funded by any organisation.';
const relatedLaws = article.relatedLaws || [];
const relatedArticles = article.relatedArticles || [];
---
<Base
  title={`${article.title} | hredd.org`}
  description={article.excerpt || article.deck || article.title}
  active="articles"
  ogType="article"
  publishedTime={article.publishedAt}
  modifiedTime={article.updatedAt || article.publishedAt}
>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.title,
  "description": article.excerpt || article.deck || article.title,
  "author": {
    "@type": "Person",
    "name": article.authorName,
    "url": "https://hredd.org/about/",
    ...(article.authorLocation ? { "address": article.authorLocation } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "hredd.org",
    "url": "https://hredd.org",
    "logo": { "@type": "ImageObject", "url": "https://hredd.org/favicon.png" }
  },
  "datePublished": article.publishedAt,
  "dateModified": article.updatedAt || article.publishedAt,
  "articleSection": article.category || "Analysis",
  "inLanguage": "en-GB",
  "isAccessibleForFree": true,
  "about": (article.relatedLaws || []).map((l) => ({
    "@type": "Legislation", "name": l.name, "legislationJurisdiction": l.jurisdiction
  })),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://hredd.org/articles/${article.slug}/` }
})} />

<section class="section" style="padding-bottom:clamp(30px,4vw,48px)">
  <div class="wrap" style="max-width:900px">
    <nav class="crumb reveal"><a href="/">hredd·org</a><span>/</span><a href="/articles/">Articles</a><span>/</span><span>{article.category || 'Analysis'}</span></nav>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(36px,5vw,68px); margin-top:28px">{article.title}</h1>
    {article.deck && <p class="standfirst reveal" data-delay="2" style="margin-top:24px">{article.deck}</p>}
    <p class="byline reveal" data-delay="3">
      <b>{article.authorName}</b>
      {article.authorLocation ? ` · ${article.authorLocation}` : ''} · {formatDate(article.publishedAt)}
      {article.readTime ? ` · ${article.readTime}` : ''}
    </p>
  </div>
</section>

<hr class="hairline" />

<section class="section">
  <div class="wrap">
    <div class="prose" set:html={bodyHtml}></div>
    <div class="disclosure" style="margin-top:clamp(40px,5vw,64px)">{disclosure}</div>
  </div>
</section>

{relatedLaws.length > 0 && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Referenced</p><h2 class="h2">Laws in this piece</h2></div>
      </div>
      <div class="law-grid reveal" data-delay="1">
        {relatedLaws.map((l) => (
          <article class="law-card" data-g={l.statusType}>
            <div class="law-top"><span class="jur">{l.jurisdiction}</span>
              <span class="chip" data-g={l.statusType}>{l.status}</span></div>
            <h3><a href={`/laws/${l.slug}/`}>{l.name}</a></h3>
            {l.oneLineSummary && <p>{l.oneLineSummary}</p>}
            <a class="textlink" href={`/laws/${l.slug}/`}>Read <i>→</i></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{relatedArticles.length > 0 && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Continue reading</p><h2 class="h2">Related pieces</h2></div>
      </div>
      <div class="law-rows reveal" data-delay="1">
        {relatedArticles.map((a) => (
          <a class="law-row" href={`/articles/${a.slug}/`}>
            <div><h3>{a.title}</h3></div>
            <span class="jur">{formatDate(a.publishedAt)}{a.readTime ? ` · ${a.readTime}` : ''}</span>
            <span class="chip">{a.category || 'Analysis'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</Base>
