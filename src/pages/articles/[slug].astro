---
import Base from '../../layouts/Base.astro';
import { getAllArticles, getSiteSettings, renderBody, formatDate } from '../../lib/sanity.js';
import { AUTHOR, authorRef, isSiteAuthor } from '../../lib/author.js';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const settings = await getSiteSettings();
const bodyHtml = renderBody(article.body);
const disclosure = article.disclosureOverride || settings?.articleDisclaimer ||
  'hredd.org is an independent publication with no affiliation with any organisation, public or private. The views contained herein are personal. hredd.org is not funded by any organisation.';
const relatedLaws = article.relatedLaws || [];
const relatedArticles = article.relatedArticles || [];

// Hero image from Sanity. Shown as a wide crop under the headline, centred
// on the hotspot set in Studio, and reused as the social sharing image.
const hero = article.heroImage?.url ? article.heroImage : null;
const heroSrc = (w, h) => `${hero.url}?w=${w}${h ? `&h=${h}&fit=crop&crop=focalpoint&fp-x=${hero.hotspot?.x ?? 0.5}&fp-y=${hero.hotspot?.y ?? 0.5}` : ''}&auto=format&q=80`;
const heroPos = hero ? `${Math.round((hero.hotspot?.x ?? 0.5) * 100)}% ${Math.round((hero.hotspot?.y ?? 0.5) * 100)}%` : '';
---
<Base
  title={`${article.title} | hredd.org`}
  description={article.excerpt || article.deck || article.title}
  active="articles"
  ogType="article"
  publishedTime={article.publishedAt}
  modifiedTime={article.updatedAt || article.publishedAt}
  ogImage={hero ? heroSrc(1200, 630) : undefined}
>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.title,
  "description": article.excerpt || article.deck || article.title,
  "author": isSiteAuthor(article.authorName) ? authorRef : {
    "@type": "Person",
    "name": article.authorName,
    ...(article.authorLocation ? { "address": article.authorLocation } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "hredd.org",
    "url": "https://hredd.org",
    "logo": { "@type": "ImageObject", "url": "https://hredd.org/favicon.png" }
  },
  ...(hero ? { "image": [heroSrc(1200, 630)] } : {}),
  "datePublished": article.publishedAt,
  "dateModified": article.updatedAt || article.publishedAt,
  "articleSection": article.category || "Analysis",
  "inLanguage": "en-GB",
  "isAccessibleForFree": true,
  "about": (article.relatedLaws || []).map((l) => ({
    "@type": "Legislation", "name": l.name, "legislationJurisdiction": l.jurisdiction
  })),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://hredd.org/articles/${article.slug}/` }
})} />

<section class="section" style="padding-bottom:clamp(30px,4vw,48px)">
  <div class="wrap" style="max-width:900px">
    <nav class="crumb reveal"><a href="/">hredd·org</a><span>/</span><a href="/articles/">Articles</a><span>/</span><span>{article.category || 'Analysis'}</span></nav>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(36px,5vw,68px); margin-top:28px">{article.title}</h1>
    {article.deck && <p class="standfirst reveal" data-delay="2" style="margin-top:24px">{article.deck}</p>}
    <p class="byline reveal" data-delay="3">
      {isSiteAuthor(article.authorName)
        ? <a href={AUTHOR.page} rel="author"><b>{article.authorName}</b></a>
        : <b>{article.authorName}</b>}
      {article.authorLocation ? ` · ${article.authorLocation}` : ''} · {formatDate(article.publishedAt)}
      {article.readTime ? ` · ${article.readTime}` : ''}
    </p>
  </div>
</section>

{hero && (
  <figure class="article-hero reveal">
    <img src={heroSrc(1800)} srcset={`${heroSrc(900)} 900w, ${heroSrc(1400)} 1400w, ${heroSrc(1800)} 1800w`}
      sizes="(max-width:1100px) 100vw, 1100px" width={hero.w} height={hero.h}
      alt={article.heroCaption || article.title} style={`object-position:${heroPos}`} />
    {(article.heroCaption || article.heroCredit) && (
      <figcaption>{article.heroCaption}{article.heroCaption && article.heroCredit ? ' · ' : ''}{article.heroCredit && <span>Photo: {article.heroCredit}</span>}</figcaption>
    )}
  </figure>
)}

<hr class="hairline" />

<section class="section">
  <div class="wrap">
    <div class="prose" set:html={bodyHtml}></div>
    <div class="disclosure" style="margin-top:clamp(40px,5vw,64px)">{disclosure}</div>
    <aside class="article-sub" aria-label="Subscribe to the monthly digest">
      <p class="kicker">The monthly digest</p>
      <h2>Get the next piece <em>by email</em></h2>
      <p>One briefing a month on what changed in due diligence law, and what it means for your orders.</p>
      <form class="sub-form" action="https://buttondown.com/api/emails/embed-subscribe/hredd" method="post" target="_blank">
        <input type="email" name="email" placeholder="you@example.org" required aria-label="Email address" />
        <button class="btn solid" type="submit"><span>Subscribe</span></button>
      </form>
      <p class="form-note">Monthly · Free · Unsubscribe anytime</p>
    </aside>
  </div>
</section>

{relatedLaws.length > 0 && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Referenced</p><h2 class="h2">Laws in this piece</h2></div>
      </div>
      <div class="law-grid reveal" data-delay="1">
        {relatedLaws.map((l) => (
          <article class="law-card" data-g={l.statusType}>
            <div class="law-top"><span class="jur">{l.jurisdiction}</span>
              <span class="chip" data-g={l.statusType}>{l.status}</span></div>
            <h3><a href={`/laws/${l.slug}/`}>{l.name}</a></h3>
            {l.oneLineSummary && <p>{l.oneLineSummary}</p>}
            <a class="textlink" href={`/laws/${l.slug}/`}>Read <i>→</i></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{relatedArticles.length > 0 && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Continue reading</p><h2 class="h2">Related pieces</h2></div>
      </div>
      <div class="law-rows reveal" data-delay="1">
        {relatedArticles.map((a) => (
          <a class="law-row" href={`/articles/${a.slug}/`}>
            <div><h3>{a.title}</h3></div>
            <span class="jur">{formatDate(a.publishedAt)}{a.readTime ? ` · ${a.readTime}` : ''}</span>
            <span class="chip">{a.category || 'Analysis'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</Base>

<style>
  /* a wide crop so portrait photos do not fill the whole screen */
  .article-hero{ max-width:1100px; margin:0 auto clamp(30px,4vw,48px); padding:0 clamp(16px,4vw,48px); }
  .article-hero img{ display:block; width:100%; height:auto; aspect-ratio:16/9; object-fit:cover;
    border:1px solid var(--line); background:var(--panel); }
  .article-hero figcaption{ margin-top:12px; font-family:var(--mono); font-size:11.5px; letter-spacing:.06em;
    color:var(--ink-faint); max-width:900px; }
  .article-hero figcaption span{ color:var(--ink-dim); }
</style>
