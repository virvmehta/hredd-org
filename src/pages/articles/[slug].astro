---
import Base from '../../layouts/Base.astro';
import { getAllArticles, getSiteSettings, renderBody, formatDate } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const settings = await getSiteSettings();
const bodyHtml = renderBody(article.body);
const disclaimer = article.disclosureOverride || settings.articleDisclaimer;
---
<Base
  title={`${article.title} | hredd.org`}
  description={article.excerpt || article.deck || article.title}
  activePage="articles"
>
  <article>
    <header class="article-hero page-pad">
      <span class="label label-accent">{article.category}</span>
      <h1>{article.title}</h1>
      {article.deck && <p class="deck">{article.deck}</p>}
      <p class="art-meta">
        {article.authorName}
        {article.authorLocation && <Fragment> &middot; {article.authorLocation}</Fragment>}
        &middot; {formatDate(article.publishedAt)} &middot; {article.readTime}
      </p>
    </header>

    <div class="page-pad">
      <div class="article-body">
        <Fragment set:html={bodyHtml} />
      </div>

      <div class="author-block">
        <div class="a-name">{article.authorName}</div>
        {article.authorBio && <div class="a-bio">{article.authorBio}</div>}
      </div>

      {disclaimer && <div class="article-disclaimer">{disclaimer}</div>}

      {article.relatedLaws?.length > 0 && (
        <div class="ref-laws">
          <h3>Laws referenced</h3>
          {article.relatedLaws.map((law) => (
            <a class="panel-law" href={`/laws/${law.slug}/`}>
              <span class="pl-head">
                <span class="pl-name">{law.name}</span>
                <span class={`status-badge status-${law.statusType}`}>{law.status}</span>
              </span>
              <span class="pl-summary">{law.oneLineSummary}</span>
              <span class="pl-more">View tracker entry &rarr;</span>
            </a>
          ))}
        </div>
      )}

      {article.relatedArticles?.length > 0 && (
        <div class="related-arts">
          <h3>Related reading</h3>
          {article.relatedArticles.map((r) => (
            <a class="r-item" href={`/articles/${r.slug}/`}>
              <span class="r-title">{r.title}</span>
              <div class="r-meta">{r.category} &middot; {formatDate(r.publishedAt)} &middot; {r.readTime}</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </article>
</Base>
