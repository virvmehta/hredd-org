---
import Base from '../layouts/Base.astro';
import { getAllArticles, getAllLaws, getSiteSettings, formatDate, formatMonthYear } from '../lib/sanity.js';

const articles = await getAllArticles();
const laws = await getAllLaws();
const settings = await getSiteSettings();

const lead = articles.find((a) => a.featured) || articles[0];
const rest = articles.filter((a) => a !== lead).slice(0, 3);

const previewLaws = laws.slice(0, 5);

const inForce = laws.filter((l) => l.statusType === 'force').length;
const pending = laws.filter((l) => l.statusType === 'pending').length;
const proposed = laws.filter((l) => l.statusType === 'proposed').length;

const mostRecent = laws.reduce((latest, l) => {
  const d = new Date(l.lastUpdated || 0);
  return d > latest ? d : latest;
}, new Date(0));
const movementsThisCycle = laws.filter((l) => {
  const d = new Date(l.lastUpdated || 0);
  return d.getFullYear() === mostRecent.getFullYear() && d.getMonth() === mostRecent.getMonth();
}).length;
---
<Base title="hredd.org | Human rights and environmental due diligence, tracked from the Global South" activePage="home">
  <section class="masthead page-pad">
    <div>
      <h1 class="masthead-title">
        Human rights<br />
        <span class="line-italic">&amp; environmental</span><br />
        due diligence
      </h1>
      <p class="masthead-tagline">{settings.tagline}</p>
      <p class="masthead-meta">Established 2026 &middot; Independent &middot; Monthly</p>
    </div>
    <aside class="this-month">
      <h2>This month</h2>
      <div class="stat">
        <div class="num">{laws.length}</div>
        <div class="lab">Laws tracked</div>
      </div>
      <div class="stat">
        <div class="num">{movementsThisCycle}</div>
        <div class="lab">Movements in {formatMonthYear(mostRecent.toISOString())}</div>
      </div>
      <div class="stat">
        <div class="num">{inForce}</div>
        <div class="lab">Regimes in force</div>
      </div>
    </aside>
  </section>

  <section class="page-pad">
    <div class="section-head rule-primary">
      <h2>Latest</h2>
      <a class="see-all" href="/articles/">All articles &rarr;</a>
    </div>
    <div class="article-grid featured-layout">
      {lead && (
        <a class="article-card lead" href={`/articles/${lead.slug}/`}>
          <span class="cat">{lead.category}</span>
          <h3>{lead.title}</h3>
          <p class="excerpt">{lead.excerpt}</p>
          <p class="byline">{lead.authorName} &middot; {formatDate(lead.publishedAt)} &middot; {lead.readTime}</p>
        </a>
      )}
      {rest.map((a) => (
        <a class="article-card" href={`/articles/${a.slug}/`}>
          <span class="cat">{a.category}</span>
          <h3>{a.title}</h3>
          <p class="excerpt">{a.excerpt}</p>
          <p class="byline">{a.authorName} &middot; {formatDate(a.publishedAt)} &middot; {a.readTime}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="page-pad">
    <div class="section-head rule-primary">
      <h2>The tracker</h2>
      <a class="see-all" href="/tracker/">Full tracker: {laws.length} laws &rarr;</a>
    </div>
    <div style="padding-bottom: 48px;">
      {previewLaws.map((law) => (
        <div class="law-row">
          <a class="law-name" href={`/laws/${law.slug}/`}>{law.name}</a>
          <span class="law-jur">{law.jurisdiction}</span>
          <span class={`status-badge status-${law.statusType}`}>{law.status}</span>
          <span class="law-update">{law.tableUpdateText}</span>
          <a class="law-link" href={`/laws/${law.slug}/`}>Read &rarr;</a>
        </div>
      ))}
    </div>
    <p style="padding-bottom: 56px; font-size: var(--text-13); color: var(--text-muted);">
      {inForce} in force &middot; {pending} pending &middot; {proposed} proposed &middot; Updated monthly with a changelog on every entry.
    </p>
  </section>

  <section class="quote-strip page-pad">
    <blockquote>&ldquo;{settings.editorialQuote}&rdquo;</blockquote>
    <cite>{settings.editorialQuoteAttribution}</cite>
  </section>

  <section class="newsletter page-pad">
    <h2>The monthly digest</h2>
    <p>{settings.newsletterBlurb}</p>
    <form action="/subscribe/" method="get">
      <input type="email" name="email" placeholder="you@example.org" aria-label="Email address" required />
      <button type="submit">Subscribe</button>
    </form>
  </section>
</Base>
