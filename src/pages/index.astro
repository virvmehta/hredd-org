---
import Base from '../layouts/Base.astro';
import { getAllLaws, getAllArticles, formatDate, formatMonthYear } from '../lib/sanity.js';
import { buildMovements, trackedGeoIds } from '../lib/redesignData.js';

const laws = await getAllLaws();
const articles = await getAllArticles();

const lead = articles.find((a) => a.featured) || articles[0];
const movements = buildMovements(laws, 3);
const latestMonth = movements[0]?.date || formatMonthYear();
const geoIds = trackedGeoIds(laws);

// The four doors, in the order a supplier actually thinks through the problem:
// awareness, mapping, personal action, national context.
const steps = [
  { href: '/tracker/', title: 'Track the laws',
    text: 'Eighteen regimes are reviewed monthly against primary sources, with a changelog on every entry.' },
  { href: '/buyer-mapping/', title: 'Check your buyers',
    text: 'Choose your buyer countries and see which laws reach those trade relationships.' },
  { href: '/report/', title: 'Get your exposure report',
    text: 'Eight questions produce a dated PDF report, and nothing leaves your device.' },
  { href: '/trade/', title: 'See your country’s exposure',
    text: 'See how much of your country’s trade each law will reach by 2030.' },
];
---
<Base
  title="hredd.org | HREDD Legislation Tracked From the Global South"
  description="An independent tracker of human rights and environmental due diligence law, read from the supplier side of the chain. Eighteen laws, updated monthly."
  active=""
>

<section class="hero">
  <div class="wrap">
    <div>
      <p class="kicker reveal">A Global South perspective</p>
      <h1 class="display reveal" data-delay="1">The due diligence laws,<br />read from the<br /><em>supplier side</em></h1>
      <p class="standfirst reveal" data-delay="2">Eighteen human rights and environmental due diligence laws now set the terms of trade with the world's largest markets. We track every one of them monthly and explain what each will ask of you.</p>
      <div class="hero-ctas reveal" data-delay="3">
        <a class="btn solid" href="/report/"><span>Get your exposure report</span> <i>→</i></a>
        <a class="btn" href="/tracker/"><span>Explore the tracker</span></a>
      </div>
    </div>
    <div class="hero-globe reveal" data-delay="2">
      <canvas id="globe" width="1120" height="1120" aria-label="Rotating globe highlighting jurisdictions with HREDD laws"></canvas>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">Start here</p>
        <h2 class="h2">Four steps through <em>the tracker</em></h2>
      </div>
    </div>
    <div class="steps reveal" data-delay="1">
      {steps.map((s) => (
        <a class="step" href={s.href}>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <span class="textlink">Open <i>→</i></span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">Changelog</p>
        <h2 class="h2">What changed <em>this month</em></h2>
      </div>
      <div class="section-head-links">
        <a class="textlink" href="/tracker/#movements">Full changelog <i>→</i></a>
        <span class="mono faint">Updated {latestMonth}</span>
      </div>
    </div>
    <div class="law-rows reveal" data-delay="1">
      {movements.map((m) => (
        <a class="law-row" href={`/laws/${m.slug}/`}>
          <div><h3>{m.tag}</h3><p class="sub">{(m.latest || '').split(';')[0]}</p></div>
          <span class="jur">{m.date}</span>
        </a>
      ))}
    </div>
  </div>
</section>

{lead && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="kicker">Articles</p>
          <h2 class="h2">Latest <em>analysis</em></h2>
        </div>
        <a class="textlink" href="/articles/">All articles <i>→</i></a>
      </div>
      <div class="feature reveal" data-delay="1">
        <div>
          <span class="chip">{lead.category || 'Analysis'}</span>
          <h3><a href={`/articles/${lead.slug}/`}>{lead.title}</a></h3>
          <p class="standfirst">{lead.excerpt || lead.deck}</p>
          <p class="byline"><b>{lead.authorName}</b> · {formatDate(lead.publishedAt)}{lead.readTime ? ` · ${lead.readTime}` : ''}</p>
        </div>
        {lead.deck && (
          <div>
            <p class="standfirst" style="font-style:italic; border-left:1px solid var(--gold-dim); padding-left:26px;">{lead.deck}</p>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<section class="statement-band">
  <div class="wrap">
    <p class="reveal">These rules are written in Brussels, Washington and Canberra, but they are answered on factory floors in Dhaka, Hanoi and Nairobi. We publish for <em>the businesses that answer them</em>.</p>
  </div>
</section>

<section class="section sub-band">
  <div class="wrap">
    <p class="kicker reveal" style="justify-content:center">The monthly digest</p>
    <h2 class="h2 reveal" data-delay="1">One monthly briefing on <em>everything that moved</em></h2>
    <p class="standfirst reveal" data-delay="2" style="margin:20px auto 0">Each issue covers what changed, what it means for your orders, and what to prepare before your buyers ask.</p>
    <form class="sub-form reveal" data-delay="3" action="https://buttondown.com/api/emails/embed-subscribe/hredd" method="post" target="_blank">
      <input type="email" name="email" placeholder="you@example.org" required aria-label="Email address" />
      <button class="btn solid" type="submit"><span>Subscribe</span></button>
    </form>
    <p class="form-note reveal" data-delay="3">Monthly · Free · Unsubscribe anytime</p>
  </div>
</section>

<script type="application/json" id="globe-data" set:html={JSON.stringify(geoIds)}></script>
<script>
  import { geoOrthographic, geoPath, geoGraticule10 } from 'd3-geo';
  import { feature } from 'topojson-client';
  import world from 'world-atlas/countries-110m.json';

  const canvas = document.getElementById('globe');
  const dataEl = document.getElementById('globe-data');
  if (canvas instanceof HTMLCanvasElement && dataEl) {
    const tracked = new Set(JSON.parse(dataEl.textContent || '[]'));
    const ctx = canvas.getContext('2d');
    const size = canvas.width;
    const R = size / 2 - 10;
    const projection = geoOrthographic().translate([size / 2, size / 2]).scale(R).clipAngle(90);
    const path = geoPath(projection, ctx);
    const graticule = geoGraticule10();
    const countries = feature(world, world.objects.countries).features;
    const sphere = { type: 'Sphere' };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let t = 0;
    let running = false;

    function frame() {
      projection.rotate([-20 + t * 4, -12]);
      ctx.clearRect(0, 0, size, size);
      const g = ctx.createRadialGradient(size / 2, size / 2, R * 0.5, size / 2, size / 2, R * 1.05);
      g.addColorStop(0, 'rgba(201,163,95,0)');
      g.addColorStop(1, 'rgba(201,163,95,.10)');
      ctx.beginPath(); path(sphere); ctx.fillStyle = g; ctx.fill();
      ctx.beginPath(); path(sphere); ctx.strokeStyle = 'rgba(201,163,95,.35)'; ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath(); path(graticule); ctx.strokeStyle = 'rgba(234,228,213,.06)'; ctx.lineWidth = 0.7; ctx.stroke();
      for (const c of countries) {
        const on = tracked.has(+c.id);
        ctx.beginPath(); path(c);
        ctx.fillStyle = on ? 'rgba(201,163,95,.55)' : 'rgba(234,228,213,.10)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(14,13,10,.9)'; ctx.lineWidth = 0.6; ctx.stroke();
      }
      if (!reduced && running) { t += 0.016; requestAnimationFrame(frame); }
    }

    // Draw once immediately, then only animate while the canvas is on screen,
    // so the loop is not burning battery under the fold on mobile devices.
    frame();
    const vio = new IntersectionObserver((es) => {
      for (const e of es) {
        const was = running;
        running = e.isIntersecting;
        if (running && !was && !reduced) requestAnimationFrame(frame);
      }
    });
    vio.observe(canvas);
  }
</script>

</Base>
