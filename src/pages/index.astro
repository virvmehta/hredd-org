---
import Base from '../layouts/Base.astro';
import { getAllLaws, getAllArticles, getSiteSettings, formatDate, formatMonthYear } from '../lib/sanity.js';
import { buildMovements, trackedGeoIds } from '../lib/redesignData.js';

const laws = await getAllLaws();
const articles = await getAllArticles();
const settings = await getSiteSettings();

const lead = articles.find((a) => a.featured) || articles[0];
const movements = buildMovements(laws, 6);
const latestMonth = movements[0]?.date || formatMonthYear();
const movementsThisMonth = movements.filter((m) => m.date === latestMonth).length;
const inForce = laws.filter((l) => l.statusType === 'force').length;
const jurisdictions = new Set(laws.map((l) => l.jurisdiction)).size;
const previewLaws = laws.slice(0, 5);
const geoIds = trackedGeoIds(laws);
const quote = settings?.editorialQuote ||
  'The question is never whether supply chains will be governed. The question is who sits at the table when the rules are written, and who just receives the questionnaires.';
const quoteBy = settings?.editorialQuoteAttribution || 'hredd·org · editorial position';
const blurb = settings?.newsletterBlurb ||
  'What moved, what it means for your trade relationships, and what to prepare before your buyers ask. No noise.';
---
<Base
  title="hredd.org | HREDD Legislation Tracked From the Global South"
  description="An independent tracker of human rights and environmental due diligence law, read from the supplier side of the chain. Eighteen laws, updated monthly."
  active=""
>

<section class="hero">
  <div class="wrap">
    <div>
      <p class="kicker reveal">A Global South perspective</p>
      <h1 class="display reveal" data-delay="1">Human rights<br />&amp; <em>environmental</em><br />due diligence</h1>
      <p class="standfirst reveal" data-delay="2">{laws.length} laws now decide who sells into the
        world's richest markets. We track every one of them, monthly, from the supplier side of the chain.</p>
      <div class="hero-ctas reveal" data-delay="3">
        <a class="btn solid" href="/tracker/"><span>Explore the tracker</span> <i>→</i></a>
        <a class="btn" href="/buyer-mapping/"><span>Map your buyers</span></a>
          <a class="btn" href="/report/"><span>Get your exposure report</span></a>
      </div>
    </div>
    <div class="hero-globe reveal" data-delay="2">
      <canvas id="globe" width="1120" height="1120" aria-label="Rotating globe highlighting jurisdictions with HREDD laws"></canvas>
    </div>
  </div>
</section>

<div class="ticker" aria-label="This month's movements">
  <div class="ticker-inner">
    {[...movements, ...movements].map((m) => (
      <span class="ticker-item"><b>{m.tag}</b> {m.date} · {(m.latest || '').split(';')[0]}</span>
    ))}
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">This month</p>
        <h2 class="h2">The state of play</h2>
      </div>
      <span class="mono faint">Updated {latestMonth}</span>
    </div>
    <div class="stats reveal" data-delay="1">
      <div class="stat"><b data-count={laws.length}>{laws.length}</b><span>Laws tracked</span></div>
      <div class="stat"><b data-count={movementsThisMonth}>{movementsThisMonth}</b><span>Movements in {latestMonth}</span></div>
      <div class="stat"><b data-count={inForce}>{inForce}</b><span>Regimes in force</span></div>
      <div class="stat"><b data-count={jurisdictions}>{jurisdictions}</b><span>Jurisdictions covered</span></div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">The tracker</p>
        <h2 class="h2">{laws.length} laws, <em>one ledger</em></h2>
      </div>
      <a class="textlink" href="/tracker/">Full tracker: {laws.length} laws <i>→</i></a>
    </div>
    <div class="law-rows reveal" data-delay="1">
      {previewLaws.map((l) => (
        <a class="law-row" href={`/laws/${l.slug}/`}>
          <div><h3>{l.name}</h3><p class="sub">{l.tableUpdateText}</p></div>
          <span class="jur">{l.jurisdiction}</span>
          <span class="chip" data-g={l.statusType}>{l.status}</span>
        </a>
      ))}
    </div>
    <p class="mono faint reveal" style="margin-top:26px">Updated monthly with a changelog on every entry</p>
  </div>
</section>

{lead && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="kicker">Latest</p>
          <h2 class="h2">From the field</h2>
        </div>
        <a class="textlink" href="/articles/">All articles <i>→</i></a>
      </div>
      <div class="feature reveal" data-delay="1">
        <div>
          <span class="chip">{lead.category || 'Analysis'}</span>
          <h3><a href={`/articles/${lead.slug}/`}>{lead.title}</a></h3>
          <p class="standfirst">{lead.excerpt || lead.deck}</p>
          <p class="byline"><b>{lead.authorName}</b> · {formatDate(lead.publishedAt)}{lead.readTime ? ` · ${lead.readTime}` : ''}</p>
        </div>
        {lead.deck && (
          <div>
            <p class="standfirst" style="font-style:italic; border-left:1px solid var(--gold-dim); padding-left:26px;">{lead.deck}</p>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<section class="quote-band">
  <div class="wrap">
    <blockquote class="reveal">{quote}
      <cite>{quoteBy}</cite>
    </blockquote>
  </div>
</section>

<section class="section sub-band">
  <div class="wrap">
    <p class="kicker reveal" style="justify-content:center">The monthly digest</p>
    <h2 class="h2 reveal" data-delay="1">One briefing. <em>Every movement.</em></h2>
    <p class="standfirst reveal" data-delay="2" style="margin:20px auto 0">{blurb}</p>
    <form class="sub-form reveal" data-delay="3" action="https://buttondown.com/api/emails/embed-subscribe/hredd" method="post" target="_blank">
      <input type="email" name="email" placeholder="you@example.org" required aria-label="Email address" />
      <button class="btn solid" type="submit"><span>Subscribe</span></button>
    </form>
    <p class="form-note reveal" data-delay="3">Monthly · Free · Unsubscribe anytime</p>
  </div>
</section>

<script type="application/json" id="globe-data" set:html={JSON.stringify(geoIds)}></script>
<script>
  import { geoOrthographic, geoPath, geoGraticule10 } from 'd3-geo';
  import { feature } from 'topojson-client';
  import world from 'world-atlas/countries-110m.json';

  const canvas = document.getElementById('globe');
  const dataEl = document.getElementById('globe-data');
  if (canvas instanceof HTMLCanvasElement && dataEl) {
    const tracked = new Set(JSON.parse(dataEl.textContent || '[]'));
    const ctx = canvas.getContext('2d');
    const size = canvas.width;
    const R = size / 2 - 10;
    const projection = geoOrthographic().translate([size / 2, size / 2]).scale(R).clipAngle(90);
    const path = geoPath(projection, ctx);
    const graticule = geoGraticule10();
    const countries = feature(world, world.objects.countries).features;
    const sphere = { type: 'Sphere' };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let t = 0;

    function frame() {
      projection.rotate([-20 + t * 4, -12]);
      ctx.clearRect(0, 0, size, size);
      const g = ctx.createRadialGradient(size / 2, size / 2, R * 0.5, size / 2, size / 2, R * 1.05);
      g.addColorStop(0, 'rgba(201,163,95,0)');
      g.addColorStop(1, 'rgba(201,163,95,.10)');
      ctx.beginPath(); path(sphere); ctx.fillStyle = g; ctx.fill();
      ctx.beginPath(); path(sphere); ctx.strokeStyle = 'rgba(201,163,95,.35)'; ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath(); path(graticule); ctx.strokeStyle = 'rgba(234,228,213,.06)'; ctx.lineWidth = 0.7; ctx.stroke();
      for (const c of countries) {
        const on = tracked.has(+c.id);
        ctx.beginPath(); path(c);
        ctx.fillStyle = on ? 'rgba(201,163,95,.55)' : 'rgba(234,228,213,.10)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(14,13,10,.9)'; ctx.lineWidth = 0.6; ctx.stroke();
      }
      if (!reduced) { t += 0.016; requestAnimationFrame(frame); }
    }
    frame();
  }

  // in-place confirmation for the subscribe band
  document.querySelectorAll('form[data-subscribe]').forEach((f) => {
    f.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const note = f.parentElement?.querySelector('.form-note');
      if (note) note.textContent = 'Thank you. You are on the list for the next issue.';
      f.querySelector('input')?.setAttribute('disabled', 'true');
    });
  });
</script>

</Base>
