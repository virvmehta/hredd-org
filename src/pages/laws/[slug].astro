---
import Base from '../../layouts/Base.astro';
import { getAllLaws, renderBody, formatDate } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const laws = await getAllLaws();
  return laws.map((law, i) => ({
    params: { slug: law.slug },
    props: {
      law,
      prev: laws[(i - 1 + laws.length) % laws.length],
      next: laws[(i + 1) % laws.length]
    }
  }));
}

const { law, prev, next } = Astro.props;
const summaryHtml = renderBody(law.summary);
---
<Base
  title={`${law.shortName || law.name} | The tracker | hredd.org`}
  description={law.oneLineSummary}
  activePage="tracker"
>
  <article>
    <header class="law-hero page-pad">
      <div class="law-eyebrow">
        <a class="label label-accent" href="/tracker/">&larr; The tracker</a>
        <span class={`status-badge status-${law.statusType}`}>{law.status}</span>
        <span class="label">{law.jurisdiction}</span>
      </div>
      <h1>{law.name}</h1>
      <p style="margin-top: 18px; font-size: var(--text-16); color: var(--text-mid); max-width: 720px;">
        {law.oneLineSummary}
      </p>
    </header>

    <div class="law-body-grid page-pad">
      <div class="law-main">
        <h2>Summary</h2>
        <Fragment set:html={summaryHtml} />

        {law.obligations?.length > 0 && (
          <>
            <h2>Key obligations</h2>
            <div>
              {law.obligations.map((ob) => (
                <div class="obligation">
                  <div class="ob-title">{ob.title}</div>
                  <div class="ob-detail">{ob.detail}</div>
                </div>
              ))}
            </div>
          </>
        )}

        {law.timeline?.length > 0 && (
          <>
            <h2>Timeline</h2>
            <div>
              {law.timeline.map((t) => (
                <div class="timeline-item">
                  <span class="tl-date">{t.date}</span>
                  <span class="tl-event">{t.event}</span>
                </div>
              ))}
            </div>
          </>
        )}

        {law.changelog?.length > 0 && (
          <>
            <h2>Tracker changelog</h2>
            <details class="changelog">
              <summary>What changed on this entry</summary>
              {law.changelog.map((c) => (
                <div class="changelog-entry">
                  <strong>{c.date}.</strong> {c.text}
                </div>
              ))}
            </details>
          </>
        )}

        {law.sources?.length > 0 && (
          <>
            <h2>Sources</h2>
            <ul class="sources">
              {law.sources.map((s) => (
                <li><a href={s.url} rel="noopener">{s.title}</a></li>
              ))}
            </ul>
          </>
        )}
      </div>

      <aside class="law-sidebar">
        <h3>Quick facts</h3>
        <div class="fact"><div class="f-lab">Status</div><div class="f-val">{law.status}</div></div>
        <div class="fact"><div class="f-lab">Enacted</div><div class="f-val">{law.enactedDate}</div></div>
        <div class="fact"><div class="f-lab">First compliance deadline</div><div class="f-val">{law.firstComplianceDeadline}</div></div>
        <div class="fact"><div class="f-lab">Companies in scope</div><div class="f-val">{law.companiesInScope}</div></div>
        <div class="fact"><div class="f-lab">Maximum penalty</div><div class="f-val">{law.maxPenalty}</div></div>
        <div class="fact"><div class="f-lab">Civil liability</div><div class="f-val">{law.civilLiability}</div></div>
        <div class="fact"><div class="f-lab">Enforcement body</div><div class="f-val">{law.enforcementBody}</div></div>
        <div class="fact"><div class="f-lab">Entry last updated</div><div class="f-val">{formatDate(law.lastUpdated)}</div></div>

        {law.sectorsAffected?.length > 0 && (
          <div class="fact">
            <div class="f-lab">Sectors most affected</div>
            <div class="tag-list">{law.sectorsAffected.map((s) => <span>{s}</span>)}</div>
          </div>
        )}

        {law.supplierCountries?.length > 0 && (
          <div class="fact">
            <div class="f-lab">Supplier countries affected</div>
            <div class="tag-list">{law.supplierCountries.map((s) => <span>{s}</span>)}</div>
          </div>
        )}
      </aside>
    </div>

    <nav class="prevnext page-pad" aria-label="Previous and next laws">
      <a href={`/laws/${prev.slug}/`}>
        <div class="pn-lab">&larr; Previous</div>
        <div class="pn-name">{prev.name}</div>
      </a>
      <a href={`/laws/${next.slug}/`} style="text-align: right;">
        <div class="pn-lab">Next &rarr;</div>
        <div class="pn-name">{next.name}</div>
      </a>
    </nav>
  </article>
</Base>
