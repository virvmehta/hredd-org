---
import Base from '../../layouts/Base.astro';
import tradeData from '../../../public/data/trade-exposure.json';
import { getAllLaws, getAllArticles, getSiteSettings, renderBody, formatDate, formatMonthYear } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const laws = await getAllLaws();
  return laws.map((law) => ({ params: { slug: law.slug }, props: { law } }));
}

const { law } = Astro.props;
const laws = await getAllLaws();
const articles = await getAllArticles();

const related = laws.filter((l) => l.slug !== law.slug && l.jurisdiction === law.jurisdiction).slice(0, 3);
const relatedArticles = articles
  .filter((a) => (a.relatedLaws || []).some((r) => r.slug === law.slug))
  .slice(0, 3);

const facts = [
  { label: 'Status', value: law.status },
  { label: 'Enacted', value: law.enactedDate },
  { label: 'First compliance deadline', value: law.firstComplianceDeadline },
  { label: 'Companies in scope', value: law.companiesInScope },
  { label: 'Maximum penalty', value: law.maxPenalty },
  { label: 'Civil liability', value: law.civilLiability },
  { label: 'Enforcement body', value: law.enforcementBody }
].filter((f) => f.value);

const summaryHtml = renderBody(law.summary);
const updatedLabel = law.lastUpdated ? formatMonthYear(law.lastUpdated) : '';

// Trade exposure panel (Regulated Trade Index, phase one)
const tradeRows = Object.entries(tradeData.countries)
  .map(([cslug, c]) => ({ cslug, name: c.name,
    value: (c.regimes_2030[law.slug]?.value?.[1]) || 0 }))
  .filter(r => r.value > 0)
  .sort((a, b) => b.value - a.value)
  .slice(0, 6);
const tradeTotal = tradeRows.reduce((s, r) => s + r.value, 0);
const tradeMax = tradeRows.length ? tradeRows[0].value : 0;
const usdBn = v => '$' + (v / 1e9).toFixed(v >= 1e10 ? 0 : 1) + 'bn';

const clampDesc = s => s.length <= 158 ? s : s.slice(0, 155).replace(/\s+\S*$/, '') + '.';
const primarySource = (law.sources || []).find(s => s.url)?.url;

// A short FAQ built from the facts an answer engine actually gets asked about
// this law. FAQPage is among the most-quoted schema types in AI overviews, and
// these are the exact question/answer pairs a supplier types into a chatbot.
const faq = [];
if(law.firstComplianceDeadline)
  faq.push({ q: `When does the ${law.shortName || law.name} apply?`,
    a: `The first compliance deadline for the ${law.name} is ${law.firstComplianceDeadline}.` });
if(law.companiesInScope)
  faq.push({ q: `Who does the ${law.shortName || law.name} apply to?`,
    a: `${law.companiesInScope}.` });
if(law.maxPenalty)
  faq.push({ q: `What are the penalties under the ${law.shortName || law.name}?`,
    a: `${law.maxPenalty}.` });
if(law.oneLineSummary)
  faq.push({ q: `What is the ${law.shortName || law.name}?`, a: law.oneLineSummary });

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Legislation",
    "name": law.name,
    "alternateName": law.shortName || undefined,
    "legislationJurisdiction": law.jurisdiction,
    "spatialCoverage": law.jurisdiction,
    "description": law.oneLineSummary,
    "legislationDate": law.enactedDate || undefined,
    "dateModified": law.lastUpdated,
    "inLanguage": "en-GB",
    "legislationLegalForce": law.statusType === 'force' ? 'InForce' : 'PartiallyInForce',
    "url": `https://hredd.org/laws/${law.slug}/`,
    ...(primarySource ? { "sameAs": primarySource } : {}),
    "isPartOf": { "@type": "WebSite", "name": "hredd.org", "url": "https://hredd.org" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Tracker", "item": "https://hredd.org/tracker/" },
      { "@type": "ListItem", "position": 2, "name": law.shortName || law.name, "item": `https://hredd.org/laws/${law.slug}/` }
    ]
  },
  ...(faq.length ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({
      "@type": "Question", "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }] : [])
];
---
{/* Title leads with the acronym people actually search (CSDDD, EUDR, UFLPA),
    then the full name. Brand suffix is allowed to truncate on the longest
    names; leading with the searched term matters more than showing "hredd.org". */}
<Base
  title={`${law.shortName && law.shortName !== law.name ? law.shortName + ': ' : ''}${law.name} | hredd.org`}
  description={clampDesc(law.oneLineSummary || `${law.name}: status, deadlines, who is in scope, and what it asks of suppliers, tracked from the Global South.`)}
  active="tracker"
  modifiedTime={law.lastUpdated}
>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="law-head">
  <div class="wrap">
    <p class="kicker reveal"><a href="/tracker/">The tracker</a>&nbsp;·&nbsp;{law.jurisdiction}</p>
    <h1 class="display reveal" data-delay="1" style="font-size:clamp(34px,4.6vw,64px); max-width:20ch">{law.name}</h1>
    <div class="law-meta reveal" data-delay="2">
      <span class="chip" data-g={law.statusType}>{law.status}</span>
      <span class="mono faint">{law.jurisdiction}</span>
      {updatedLabel && <span class="mono faint">Entry updated {updatedLabel}</span>}
    </div>
    {law.oneLineSummary && <p class="standfirst reveal" data-delay="3" style="margin-top:26px">{law.oneLineSummary}</p>}
  </div>
</section>

{facts.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="facts reveal">
        {facts.map((f) => (
          <div class="fact"><span>{f.label}</span><b>{f.value}</b></div>
        ))}
      </div>
    </div>
  </section>
)}

{law.tableUpdateText && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="panel reveal">
        <h4>Latest movement</h4>
        <p style="margin:0; font-size:18px; line-height:1.65">{law.tableUpdateText}</p>
      </div>
    </div>
  </section>
)}

{summaryHtml && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">In plain language</p><h2 class="h2">What this law does</h2></div>
      </div>
      <div class="prose" style="margin:0" set:html={summaryHtml}></div>
    </div>
  </section>
)}

{law.obligations && law.obligations.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Obligations</p><h2 class="h2">What it asks of companies</h2></div>
      </div>
      <ol class="oblist reveal" data-delay="1">
        {law.obligations.map((o) => (
          <li><div><h3>{o.title}</h3><p>{o.detail}</p></div></li>
        ))}
      </ol>
    </div>
  </section>
)}

{law.timeline && law.timeline.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Timeline</p><h2 class="h2">How it got here</h2></div>
      <a class="textlink" href={`/timeline/${law.slug}/`}>Full timeline with what comes next <i>→</i></a>
      </div>
      <div class="timeline">
        {law.timeline.map((t, i) => (
          <div class="tl-item reveal" data-delay={Math.min(i, 3)}>
            <span class="date">{t.date}</span>
            <p style="margin-top:8px">{t.event}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{law.changelog && law.changelog.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Changelog</p><h2 class="h2">Entry history</h2></div>
      </div>
      <div class="timeline">
        {law.changelog.map((c, i) => (
          <div class="tl-item reveal" data-delay={Math.min(i, 3)}>
            <span class="date">{c.date}</span>
            <p style="margin-top:8px">{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{tradeRows.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="panel reveal">
        <h4>Trade under this regime · Regulated Trade Index</h4>
        <p class="mono faint" style="margin:0 0 18px">Exposed export value at full application, across the ten tracked origins · {tradeData.sample_data ? 'SAMPLE DATA, ILLUSTRATIVE ONLY' : tradeData.vintage} · <a href="/methodology/" style="color:var(--gold)">methodology</a></p>
        <div style="font:400 42px/1 var(--serif); color:var(--gold-hi); margin-bottom:20px">{usdBn(tradeTotal)}</div>
        {tradeRows.map(r => (
          <a href={`/trade/#${r.cslug}`} style="display:grid; grid-template-columns:120px 1fr 74px; gap:14px; align-items:center; padding:8px 0; border-bottom:1px solid var(--line-soft)">
            <span style="font-size:14px; color:var(--ink-dim)">{r.name}</span>
            <span style="height:6px; background:var(--panel-2); position:relative; display:block"><i style={`position:absolute; inset:0; width:${Math.round(r.value / tradeMax * 100)}%; background:linear-gradient(90deg,var(--gold-dim),var(--gold))`}></i></span>
            <span class="mono faint" style="text-align:right">{usdBn(r.value)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{law.sources && law.sources.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Sources</p><h2 class="h2">Primary documents</h2></div>
      </div>
      <ul class="sources reveal" data-delay="1">
        {law.sources.map((s) => (
          <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

{relatedArticles.length > 0 && (
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Coverage</p><h2 class="h2">We wrote about this</h2></div>
      </div>
      <div class="law-rows reveal" data-delay="1">
        {relatedArticles.map((a) => (
          <a class="law-row" href={`/articles/${a.slug}/`}>
            <div><h3>{a.title}</h3></div>
            <span class="jur">{formatDate(a.publishedAt)}</span>
            <span class="chip">{a.category || 'Analysis'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{related.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Same jurisdiction</p><h2 class="h2">Related regimes</h2></div>
      </div>
      <div class="law-grid reveal" data-delay="1">
        {related.map((r) => (
          <article class="law-card" data-g={r.statusType}>
            <div class="law-top"><span class="jur">{r.jurisdiction}</span>
              <span class="chip" data-g={r.statusType}>{r.status}</span></div>
            <h3><a href={`/laws/${r.slug}/`}>{r.name}</a></h3>
            <p>{r.tableUpdateText}</p>
            <a class="textlink" href={`/laws/${r.slug}/`}>Read <i>→</i></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

</Base>
