---
// Locale-aware homepage body, shared by the English (/) and Bangla (/bn/)
// pages so there is one source of truth. Only chrome and framing prose are
// translated; law names, article titles, dates and changelog text come from
// data and stay in their original language until human-translated.
import { getAllLaws, getAllArticles, formatDate, formatMonthYear } from '../lib/sanity.js';
import { buildMovements, trackedGeoIds } from '../lib/redesignData.js';
import { t } from '../lib/i18n.js';

const { locale = 'en' } = Astro.props;

const laws = await getAllLaws();
const articles = await getAllArticles();
const lead = articles.find((a) => a.featured) || articles[0];
const movements = buildMovements(laws, 3);
const latestMonth = movements[0]?.date || formatMonthYear();
const geoIds = trackedGeoIds(laws);

// Globe arcs: each supplier country is joined to the capitals of its two
// largest regulated export markets, taken from the trade dataset, so the
// lines show real trade relationships and not decoration.
import trade from '../../public/data/trade-exposure.json';
const CAPITAL = { EU27: [4.35, 50.85], USA: [-77.04, 38.9], GBR: [-0.13, 51.51], CAN: [-75.7, 45.42],
  AUS: [149.13, -35.28], JPN: [139.69, 35.68], KOR: [126.98, 37.57], CHE: [7.45, 46.95], NOR: [10.75, 59.91] };
const SUPPLIER = { bangladesh: [90.41, 23.81], india: [77.21, 28.61], vietnam: [105.85, 21.03],
  indonesia: [106.85, -6.21], brazil: [-47.93, -15.78], thailand: [100.5, 13.76], ethiopia: [38.75, 9.03],
  kenya: [36.82, -1.29], ghana: [-0.19, 5.6], 'cote-divoire': [-4.01, 5.35] };
const arcs = [];
for (const [slug, c] of Object.entries(trade.countries)) {
  if (!SUPPLIER[slug]) continue;
  for (const m of c.markets.filter((x) => CAPITAL[x.key]).slice(0, 2)) arcs.push({ a: CAPITAL[m.key], b: SUPPLIER[slug] });
}
const globeData = { tracked: geoIds, arcs, suppliers: Object.values(SUPPLIER), capitals: Object.values(CAPITAL) };

// Countdown: the next statutory date across every tracked law, read from the
// same pipeline mapping the timelines use. The day count is recomputed in the
// browser, so it stays right between builds.
import scope from '../../pipeline/law_scope.json';
const todayISO = new Date().toISOString().slice(0, 10);
const upcoming = scope.regimes
  .flatMap((r) => (r.steps || []).map((s) => ({ ...s, slug: r.slug })))
  .filter((s) => s.date > todayISO)
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((s) => ({ ...s, law: laws.find((l) => l.slug === s.slug) }))
  .find((s) => s.law);
const countdown = upcoming && {
  date: upcoming.date,
  days: Math.ceil((new Date(upcoming.date + 'T00:00:00Z') - Date.now()) / 86400000),
  href: `/timeline/${upcoming.slug}/`,
  name: upcoming.law.shortName || upcoming.law.name,
  when: new Date(upcoming.date + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }),
};

// Returning visitors who chose a country on the trade index or in the report
// are greeted with that country's figure. The choice lives only in their own
// browser (localStorage), never on a server.
const NICE_NAME = { 'cote-divoire': "Côte d'Ivoire" };
const greetData = Object.fromEntries(Object.entries(trade.countries).map(([slug, c]) =>
  [slug, { name: NICE_NAME[slug] || c.name, laws: c.laws_touching }]));

const steps = [
  { href: '/tracker/', title: t(locale, 'home.step1.title'), text: t(locale, 'home.step1.text') },
  { href: '/buyer-mapping/', title: t(locale, 'home.step2.title'), text: t(locale, 'home.step2.text') },
  { href: '/report/', title: t(locale, 'home.step3.title'), text: t(locale, 'home.step3.text') },
  { href: '/trade/', title: t(locale, 'home.step4.title'), text: t(locale, 'home.step4.text') },
];
---
<section class="hero">
  <div class="wrap">
    <div>
      <p class="kicker reveal">{t(locale, 'home.kicker')}</p>
      <h1 class="display reveal" data-delay="1" set:html={t(locale, 'home.h1')}></h1>
      <p class="standfirst reveal" data-delay="2">{t(locale, 'home.standfirst')}</p>
      <div class="hero-ctas reveal" data-delay="3">
        <a class="btn solid" href="/report/"><span>{t(locale, 'home.cta.report')}</span> <i>→</i></a>
        <a class="btn" href="/tracker/"><span>{t(locale, 'home.cta.tracker')}</span></a>
      </div>
      {locale === 'en' && (
        <a class="greet" id="greet" href="/trade/" hidden>
          <span class="mono">Your country</span>
          <span class="greet-text" id="greet-text"></span> <i>→</i>
        </a>
      )}
      {locale === 'en' && countdown && (
        <a class="countdown reveal" data-delay="3" id="countdown" href={countdown.href} data-date={countdown.date}>
          <b id="countdown-n">{countdown.days}</b>
          <span class="cd-text">
            <span class="mono" id="countdown-unit">days to the next statutory date</span>
            <span class="cd-law">{countdown.name}, {countdown.when} <i>→</i></span>
          </span>
        </a>
      )}
    </div>
    <div class="hero-globe reveal" data-delay="2">
      <canvas id="globe" width="1120" height="1120" role="img" aria-label="Globe showing lines from the capitals where due diligence laws are made to the supplier countries they reach. Drag to turn it."></canvas>
      {locale === 'en' && <p class="globe-note mono">Drag the globe to follow each law from its capital to its suppliers.</p>}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{t(locale, 'home.start.kicker')}</p>
        <h2 class="h2" set:html={t(locale, 'home.start.h2')}></h2>
      </div>
    </div>
    <div class="steps reveal" data-delay="1">
      {steps.map((s, i) => (
        <a class="step" href={s.href}>
          <span class="step-n mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="step-body"><b>{s.title}</b><span class="step-text">{s.text}</span></span>
          <i class="step-arrow">→</i>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{t(locale, 'home.changelog.kicker')}</p>
        <h2 class="h2" set:html={t(locale, 'home.changelog.h2')}></h2>
      </div>
      <div class="section-head-links">
        <a class="textlink" href="/tracker/#movements">{t(locale, 'home.changelog.full')} <i>→</i></a>
        <span class="mono faint">{t(locale, 'home.changelog.updated')} {latestMonth}</span>
      </div>
    </div>
    <div class="law-rows reveal" data-delay="1">
      {movements.map((m) => (
        <a class="law-row" href={`/laws/${m.slug}/`}>
          <div><h3>{m.tag}</h3><p class="sub">{(m.latest || '').split(';')[0]}</p></div>
          <span class="jur">{m.date}</span>
        </a>
      ))}
    </div>
  </div>
</section>

{lead && (
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="kicker">{t(locale, 'home.articles.kicker')}</p>
          <h2 class="h2" set:html={t(locale, 'home.articles.h2')}></h2>
        </div>
        <a class="textlink" href="/articles/">{t(locale, 'home.articles.all')} <i>→</i></a>
      </div>
      <div class="feature reveal" data-delay="1">
        <div>
          <span class="chip">{lead.category || 'Analysis'}</span>
          <h3><a href={`/articles/${lead.slug}/`}>{lead.title}</a></h3>
          <p class="standfirst">{lead.excerpt || lead.deck}</p>
          <p class="byline"><b>{lead.authorName}</b> · {formatDate(lead.publishedAt)}{lead.readTime ? ` · ${lead.readTime}` : ''}</p>
        </div>
        {lead.deck && (
          <div>
            <p class="standfirst" style="font-style:italic; border-left:1px solid var(--gold-dim); padding-left:26px;">{lead.deck}</p>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<section class="statement-band">
  <div class="wrap">
    <p class="reveal" set:html={t(locale, 'home.statement')}></p>
  </div>
</section>

<section class="section sub-band">
  <div class="wrap">
    <p class="kicker reveal" style="justify-content:center">{t(locale, 'home.sub.kicker')}</p>
    <h2 class="h2 reveal" data-delay="1" set:html={t(locale, 'home.sub.h2')}></h2>
    <p class="standfirst reveal" data-delay="2" style="margin:20px auto 0">{t(locale, 'home.sub.blurb')}</p>
    <form class="sub-form reveal" data-delay="3" action="https://buttondown.com/api/emails/embed-subscribe/hredd" method="post" target="_blank">
      <input type="email" name="email" placeholder="you@example.org" required aria-label="Email address" />
      <button class="btn solid" type="submit"><span>{t(locale, 'home.sub.button')}</span></button>
    </form>
    <p class="form-note reveal" data-delay="3">{t(locale, 'home.sub.note')}</p>
  </div>
</section>

<script type="application/json" id="globe-data" set:html={JSON.stringify(globeData)}></script>
<script>
  import { geoOrthographic, geoPath, geoGraticule10, geoInterpolate, geoDistance } from 'd3-geo';
  import { feature } from 'topojson-client';
  import world from 'world-atlas/countries-110m.json';

  const canvas = document.getElementById('globe');
  const dataEl = document.getElementById('globe-data');
  if (canvas instanceof HTMLCanvasElement && dataEl) {
    const data = JSON.parse(dataEl.textContent || '{}');
    const tracked = new Set(data.tracked || []);
    const arcs = (data.arcs || []).map((x, i) => ({ ...x, line: { type: 'LineString', coordinates: [x.a, x.b] },
      at: geoInterpolate(x.a, x.b), offset: (i * 0.137) % 1 }));
    const ctx = canvas.getContext('2d');
    const size = canvas.width;
    const R = size / 2 - 10;
    const projection = geoOrthographic().translate([size / 2, size / 2]).scale(R).clipAngle(90);
    const path = geoPath(projection, ctx);
    const graticule = geoGraticule10();
    const countries = feature(world, world.objects.countries).features;
    const sphere = { type: 'Sphere' };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Open on the Arabian Sea, so Africa and South Asia face the reader.
    let lambda = -62, phi = -14;
    let running = false, dragging = false, idleUntil = 0, lastX = 0, lastY = 0, queued = false;

    const visible = (p) => geoDistance(p, [-lambda, -phi]) < Math.PI / 2 - 0.02;
    function dot(p, r, fill, stroke) {
      if (!visible(p)) return;
      const xy = projection(p);
      ctx.beginPath(); ctx.arc(xy[0], xy[1], r, 0, Math.PI * 2);
      if (fill) { ctx.fillStyle = fill; ctx.fill(); }
      if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 2; ctx.stroke(); }
    }

    function draw(now) {
      projection.rotate([lambda, phi]);
      ctx.clearRect(0, 0, size, size);
      const g = ctx.createRadialGradient(size / 2, size / 2, R * 0.5, size / 2, size / 2, R * 1.05);
      g.addColorStop(0, 'rgba(201,163,95,0)');
      g.addColorStop(1, 'rgba(201,163,95,.10)');
      ctx.beginPath(); path(sphere); ctx.fillStyle = g; ctx.fill();
      ctx.beginPath(); path(sphere); ctx.strokeStyle = 'rgba(201,163,95,.35)'; ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath(); path(graticule); ctx.strokeStyle = 'rgba(234,228,213,.06)'; ctx.lineWidth = 0.7; ctx.stroke();
      for (const c of countries) {
        const on = tracked.has(+c.id);
        ctx.beginPath(); path(c);
        ctx.fillStyle = on ? 'rgba(201,163,95,.55)' : 'rgba(234,228,213,.10)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(14,13,10,.9)'; ctx.lineWidth = 0.6; ctx.stroke();
      }
      // arcs from the law-making capitals to the supplier countries
      ctx.lineWidth = 2;
      ctx.strokeStyle = 'rgba(226,194,134,.38)';
      for (const arc of arcs) { ctx.beginPath(); path(arc.line); ctx.stroke(); }
      for (const p of data.capitals || []) dot(p, 6, 'rgba(14,13,10,.9)', 'rgba(226,194,134,.9)');
      for (const p of data.suppliers || []) dot(p, 7, '#e2c286', null);
      // a point of light travels each arc, capital to supplier
      if (!reduced) {
        for (const arc of arcs) {
          const k = ((now || 0) / 3200 + arc.offset) % 1;
          dot(arc.at(k), 4.5, 'rgba(255,240,210,.95)', null);
        }
      }
    }

    function loop(now) {
      queued = false;
      if (!dragging && !reduced && now > idleUntil) lambda += 0.05;
      draw(now);
      if (running && !reduced) { queued = true; requestAnimationFrame(loop); }
    }
    const kick = () => { if (!queued) { queued = true; requestAnimationFrame(loop); } };

    canvas.addEventListener('pointerdown', (e) => {
      dragging = true; lastX = e.clientX; lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId); canvas.classList.add('dragging');
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      lambda += (e.clientX - lastX) * 0.35;
      phi = Math.max(-55, Math.min(55, phi - (e.clientY - lastY) * 0.35));
      lastX = e.clientX; lastY = e.clientY;
      kick();
    });
    const release = () => { if (dragging) { dragging = false; idleUntil = performance.now() + 2500; canvas.classList.remove('dragging'); } };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    // keyboard: arrow keys turn the globe
    canvas.tabIndex = 0;
    canvas.addEventListener('keydown', (e) => {
      const step = { ArrowLeft: [-8, 0], ArrowRight: [8, 0], ArrowUp: [0, 6], ArrowDown: [0, -6] }[e.key];
      if (!step) return;
      e.preventDefault();
      lambda += step[0]; phi = Math.max(-55, Math.min(55, phi + step[1]));
      idleUntil = performance.now() + 2500; kick();
    });

    draw(0);
    const vio = new IntersectionObserver((es) => {
      for (const e of es) { running = e.isIntersecting; if (running) kick(); }
    });
    vio.observe(canvas);
  }
</script>

<style>
  .hero-globe canvas{ cursor:grab; touch-action:pan-y; outline-offset:6px; }
  .hero-globe canvas.dragging{ cursor:grabbing; }
  .hero-globe canvas:focus-visible{ outline:1px solid var(--gold); border-radius:50%; }
  .globe-note{ margin:14px 0 0; text-align:center; font-size:10.5px; letter-spacing:.1em; color:var(--ink-dim); }
  .greet{ display:flex; flex-wrap:wrap; align-items:baseline; gap:6px 14px; margin-top:30px;
    font:400 18px/1.4 var(--serif); color:var(--ink); max-width:56ch; }
  .greet[hidden]{ display:none; }
  .greet .mono{ color:var(--gold); font-size:11px; }
  .greet i{ font-style:normal; color:var(--gold); transition:transform .3s; }
  .greet:hover .greet-text{ color:var(--gold-hi); }
  .greet:hover i{ transform:translateX(4px); }
  .countdown{ display:inline-flex; align-items:center; gap:18px; margin-top:34px; padding:14px 22px 14px 18px;
    border:1px solid var(--line); border-left:2px solid var(--gold); background:var(--bg-raise);
    transition:border-color .3s, background .3s; }
  .countdown:hover{ border-color:var(--gold-dim); border-left-color:var(--gold-hi); background:var(--panel); }
  .countdown b{ font:400 clamp(40px,4.4vw,56px)/1 var(--serif); color:var(--gold-hi);
    font-variant-numeric:tabular-nums; min-width:1.2em; text-align:right; }
  .cd-text{ display:flex; flex-direction:column; gap:5px; }
  .cd-text .mono{ font-size:10.5px; color:var(--ink-dim); }
  .cd-law{ font:400 17px/1.3 var(--serif); color:var(--ink); }
  .cd-law i{ font-style:normal; color:var(--gold); margin-left:4px; }
</style>

<script type="application/json" id="greet-data" set:html={JSON.stringify({ total: laws.length, countries: greetData })}></script>
<script is:inline>
  // Greet a returning visitor with the country they chose earlier.
  (function () {
    var box = document.getElementById('greet'), src = document.getElementById('greet-data');
    if (!box || !src) return;
    var slug = null;
    try { slug = localStorage.getItem('hredd_country'); } catch (e) {}
    var data = JSON.parse(src.textContent || '{}');
    var c = slug && data.countries && data.countries[slug];
    if (!c) return;
    document.getElementById('greet-text').textContent =
      c.laws + ' of the ' + data.total + ' tracked laws reach ' + c.name + '’s exports.';
    box.href = '/trade/#' + slug;
    box.hidden = false;
  })();
</script>

<script is:inline>
  // Recount the days in the reader's own browser, and hide the box once the
  // date has passed and the site has not yet been rebuilt.
  (function () {
    var box = document.getElementById('countdown');
    if (!box) return;
    var days = Math.ceil((new Date(box.dataset.date + 'T00:00:00Z') - Date.now()) / 86400000);
    if (days < 1) { box.hidden = true; return; }
    document.getElementById('countdown-n').textContent = String(days);
    if (days === 1) document.getElementById('countdown-unit').textContent = 'day to the next statutory date';
  })();
</script>
